{% comment %}
    Renders a product card (Style 2 - Horizontal layout matching "Most Searched Products" reference design)

    Accepts:
    - product_card_product: {Object} Product Liquid object (optional)
    - media_size: {String} Size of the product image card.
    - show_secondary_image: {Boolean} Show the secondary image on hover. Default: false
    - add_image_padding: {Boolean} Enables padding on the image
    - show_vendor: {Boolean} Show the product vendor. Default: false
    - show_rating: {Boolean} Show the product rating. Default: false

    Usage:
    {% render 'product-grid-2', product_card_product: product %}
{% endcomment %}

{{ 'component-rating.css' | asset_url | stylesheet_tag }}
{{ 'product-grid-2.css' | asset_url | stylesheet_tag }}

<div class="card-wrapper product-grid-2" data-product-id="{{ product_card_product.id }}">
  <span class="visually-hidden">{{ product_card_product.title | escape }}</span>

  <!-- Left: Image Column -->
  <div class="product-grid-2__image-col">
    <a href="{{ product_card_product.url | default: '#' }}" class="product-grid-2__image-link" aria-label="{{ product_card_product.title | escape }}">
      {%- if product_card_product.featured_media -%}
        <img
          srcset="{%- if product_card_product.featured_media.width >= 165 -%}{{ product_card_product.featured_media | img_url: '165x' }} 165w,{%- endif -%}
            {%- if product_card_product.featured_media.width >= 360 -%}{{ product_card_product.featured_media | img_url: '360x' }} 360w,{%- endif -%}
            {%- if product_card_product.featured_media.width >= 533 -%}{{ product_card_product.featured_media | img_url: '533x' }} 533w,{%- endif -%}
            {{ product_card_product.featured_media | img_url: 'master' }} {{ product_card_product.featured_media.width }}w"
          src="{{ product_card_product.featured_media | img_url: '360x' }}"
          alt="{{ product_card_product.featured_media.alt | default: product_card_product.title | escape }}"
          loading="lazy"
          class="product-grid-2__image"
          width="{{ product_card_product.featured_media.width }}"
          height="{{ product_card_product.featured_media.height }}"
        >
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg product-grid-2__image' }}
      {%- endif -%}
    </a>
  </div>

  <!-- Right: Content Column -->
  <div class="product-grid-2__content-col">
    <!-- Category Badge (Top) -->
    <div class="product-grid-2__category-badge">
      <span>
        {%- if product_card_product.type != blank -%}
          {{ product_card_product.type }}
        {%- elsif product_card_product.collections.first.title != blank -%}
          {{ product_card_product.collections.first.title }}
        {%- else -%}
          Industrial Equipment
        {%- endif -%}
      </span>
    </div>

    <!-- Product Title -->
    <h3 class="product-grid-2__title">
      <a href="{{ product_card_product.url | default: '#' }}">
        {{ product_card_product.title | escape }}
      </a>
    </h3>

    <!-- Product Code -->
    {%- assign product_code = product_card_product.metafields.custom.product_code.value | default: product_card_product.selected_or_first_available_variant.sku -%}
    {%- if product_code != blank -%}
      <div class="product-grid-2__code">{{ product_code }}</div>
    {%- endif -%}

    <!-- Price -->
    <div class="product-grid-2__price">
      {%- if product_card_product.price_varies -%}
        <span class="product-grid-2__price-regular">{{ product_card_product.price_min | money }}</span>
      {%- else -%}
        <span class="product-grid-2__price-regular">{{ product_card_product.price | money }}</span>
      {%- endif -%}
      {%- if product_card_product.compare_at_price > product_card_product.price -%}
        <s class="product-grid-2__price-compare">{{ product_card_product.compare_at_price | money }}</s>
      {%- endif -%}
    </div>

    <!-- Specifications Row (3 Columns) -->
    <div class="product-grid-2__specs-row">
      <div class="product-grid-2__spec">
        <span class="product-grid-2__spec-val">{{ product_card_product.metafields.specs.accuracy | default: '± 0.5%' }}</span>
        <span class="product-grid-2__spec-lbl">Accuracy</span>
      </div>
      <div class="product-grid-2__spec">
        <span class="product-grid-2__spec-val">{{ product_card_product.metafields.specs.size_range | default: 'DN15 – DN2000' }}</span>
        <span class="product-grid-2__spec-lbl">Size Range</span>
      </div>
      <div class="product-grid-2__spec">
        <span class="product-grid-2__spec-val">{{ product_card_product.metafields.specs.protection | default: 'IP67' }}</span>
        <span class="product-grid-2__spec-lbl">Protection</span>
      </div>
    </div>

    <!-- Footer Actions (Download Data Sheet & View Product) -->
    <div class="product-grid-2__actions">
      {%- if product_card_product.metafields.custom.data_sheet != blank -%}
        <a class="product-grid-2__datasheet" href="{{ product_card_product.metafields.custom.data_sheet | file_url }}" target="_blank" rel="noopener">
          <svg class="product-grid-2__datasheet-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>Download Data Sheet</span>
        </a>
      {%- else -%}
        <a class="product-grid-2__datasheet" href="{{ product_card_product.url | default: '#' }}">
          <svg class="product-grid-2__datasheet-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span>Download Data Sheet</span>
        </a>
      {%- endif -%}
      <a class="product-grid-2__btn" href="{{ product_card_product.url | default: '#' }}">View Product</a>
    </div>
  </div>
</div>