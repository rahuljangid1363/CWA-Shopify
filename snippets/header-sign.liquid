<!-- snippets/header-sign.liquid -->
{{ 'header-sign.css' | asset_url | stylesheet_tag }}

<div class="header-sign">
  <button class="show_login header-action-btn" type="button" title="Account" aria-label="Account">
    {%- render 'icon-user' -%}
    <span class="d-none">Account</span>
  </button>

  <div class="mini-acount">
    {% if customer %}
      {%- assign customer_first_name = '' -%}
      {%- if customer.first_name != blank -%}
        {%- assign customer_first_name = customer.first_name | strip | split: ' ' | first | capitalize -%}
      {%- elsif customer.name != blank -%}
        {%- assign customer_first_name = customer.name | strip | split: ' ' | first | capitalize -%}
      {%- elsif customer.default_address.first_name != blank -%}
        {%- assign customer_first_name = customer.default_address.first_name | strip | split: ' ' | first | capitalize -%}
      {%- elsif customer.default_address.name != blank -%}
        {%- assign customer_first_name = customer.default_address.name | strip | split: ' ' | first | capitalize -%}
      {%- elsif customer.last_name != blank -%}
        {%- assign customer_first_name = customer.last_name | strip | capitalize -%}
      {%- endif -%}
      <p><a class="js-customer-greeting" href="/account">Hello{% if customer_first_name != blank %} {{ customer_first_name }}{% endif %}</a></p>
      <p><a href="/account/logout" title="{{ 'layout.customer.log_out' | t }}" class="site-header__link js-logout-link">Logout</a></p>
      <p><a href="/account" title="My account">My account</a></p>
    {% else %}
      <p><a href="/account/login" class="site-header__link">Sign in</a></p>
      <p><a href="/account/register" title="Register">Register</a></p>
    {% endif %}
    <p><a href="/pages/wishlist" title="Wishlist">Wishlist (<span class="js-wishlist-count"></span>)</a></p>
    <p><a href="/pages/compare" class="site-header__compare" title="Compare">Compare (<span class="js-compare-count text-center"></span>)</a></p>
    <p><a href="/cart" title="Checkout">Checkout</a></p>
  </div>
</div>

<script>
  (function () {
    {% if customer %}
      var serverFirstName = {{ customer_first_name | json }};
      var serverFullName = {{ customer.name | default: customer.first_name | json }};
      if (serverFirstName) {
        try {
          localStorage.setItem('customer_first_name', serverFirstName);
          if (serverFullName) localStorage.setItem('customer_name', serverFullName);
        } catch(e) {}
      }
    {% endif %}

    function updateGreeting() {
      var name = '';
      {% if customer %}
        name = {{ customer_first_name | json }};
      {% endif %}
      if (!name) {
        try {
          name = localStorage.getItem('customer_first_name') || '';
          if (!name) {
            var full = localStorage.getItem('customer_name') || localStorage.getItem('user_name') || '';
            if (full) {
              name = full.trim().split(/\s+/)[0];
            }
          }
        } catch(e) {}
      }
      if (name) {
        name = name.charAt(0).toUpperCase() + name.slice(1);
        document.querySelectorAll('.js-customer-greeting').forEach(function(el) {
          el.textContent = 'Hello ' + name;
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', updateGreeting);
    } else {
      updateGreeting();
    }

    if (window._headerSignInit) return;
    window._headerSignInit = true;

    document.addEventListener('click', function (e) {
      var btn = e.target.closest('.header-sign .show_login');
      if (btn) {
        e.preventDefault();
        e.stopPropagation();
        updateGreeting();
        var parent = btn.closest('.header-sign');
        var dropdown = parent ? parent.querySelector('.mini-acount') : null;
        if (dropdown) {
          var isShown = dropdown.classList.contains('is-open') || dropdown.classList.contains('active') || window.getComputedStyle(dropdown).display !== 'none';
          
          // Close all dropdowns
          document.querySelectorAll('.mini-acount').forEach(function(el) {
            el.classList.remove('is-open', 'active');
            el.style.display = 'none';
          });
          document.querySelectorAll('.header-sign').forEach(function(el) {
            el.classList.remove('is-active', 'active');
          });

          if (!isShown) {
            dropdown.classList.add('is-open', 'active');
            dropdown.style.display = 'block';
            parent.classList.add('is-active', 'active');
          }
        }
        return;
      }

      // Close if clicking outside
      if (!e.target.closest('.header-sign')) {
        document.querySelectorAll('.mini-acount').forEach(function(el) {
          el.classList.remove('is-open', 'active');
          el.style.display = 'none';
        });
        document.querySelectorAll('.header-sign').forEach(function(el) {
          el.classList.remove('is-active', 'active');
        });
      }

      // Clear stored customer name on logout
      if (e.target.closest('a[href*="/account/logout"], .js-logout-link')) {
        try {
          localStorage.removeItem('customer_first_name');
          localStorage.removeItem('customer_name');
          localStorage.removeItem('user_name');
        } catch(e) {}
      }
    });
  })();
</script>