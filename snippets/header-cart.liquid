<!-- snippets/header-cart.liquid -->
{{ 'component-mini-cart.css' | asset_url | stylesheet_tag }}

<div class="header-cart">
  <a href="{{ routes.cart_url }}" class="header__icon header__icon--cart header-action-btn link link--text focus-inset" id="cart-icon-bubble" title="Cart" aria-label="Cart">
    {%- liquid
      if cart == empty
        render 'icon-cart-empty'
      else
        render 'icon-cart'
      endif
    -%}
    <span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
    {%- if cart != empty and cart.item_count > 0 -%}
      <div class="cart-count-bubble">
        <span aria-hidden="true">{{ cart.item_count }}</span>
        <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
      </div>
    {%- endif -%}
    <span class="d-none">Cart</span>
  </a>

  {% render 'mini-cart' %}
</div>