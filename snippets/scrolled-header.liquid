<!-- snippets/scrolled-header.liquid -->
{{ 'scrolled-header.css' | asset_url | stylesheet_tag }}

{%- assign industryBlocks = section.blocks | where: 'type', 'industry_item' -%}
{%- assign main_menu_handle = settings.main_linklist | default: 'main-menu' -%}

<div class="scrolled-header-sticky">
  <div class="scrolled-header__inner">
    <!-- Left Section: Logo, Categories, Divider, Navigation -->
    <div class="scrolled-header__left">
      <!-- CWA Logo -->
      <div class="scrolled-header__logo">
        <a href="{{ routes.root_url }}" class="scrolled-header__logo-link" aria-label="{{ shop.name }}">
          {%- if settings.logo != blank -%}
            <img
              src="{{ settings.logo | img_url: 'master' }}"
              alt="{{ settings.logo.alt | default: shop.name | escape }}"
              class="scrolled-header__logo-img"
              loading="lazy"
            >
          {%- else -%}
            <span class="scrolled-header__logo-text">{{ shop.name }}</span>
          {%- endif -%}
        </a>
      </div>

      <!-- Shop by Categories Trigger & Dropdown -->
      <div class="scrolled-header__categories">
        <button type="button" class="scrolled-header__cat-btn vertical-bars" aria-label="Shop by Categories">
          <svg class="scrolled-header__cat-icon" width="16" height="12" viewBox="0 0 16 12" fill="none">
            <path d="M0 1C0 0.45 0.45 0 1 0H15C15.55 0 16 0.45 16 1C16 1.55 15.55 2 15 2H1C0.45 2 0 1.55 0 1Z" fill="#00B5E2"/>
            <path d="M0 6C0 5.45 0.45 5 1 5H11C11.55 5 12 5.45 12 6C12 6.55 11.55 7 11 7H1C0.45 7 0 6.55 0 6Z" fill="#00B5E2"/>
            <path d="M0 11C0 10.45 0.45 10 1 10H7C7.55 10 8 10.45 8 11C8 11.55 7.55 12 7 12H1C0.45 12 0 11.55 0 11Z" fill="#00B5E2"/>
          </svg>
          <span class="scrolled-header__cat-text">SHOP BY CATEGORIES</span>
          <svg class="scrolled-header__cat-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none">
            <path d="M2 4.5L6 8.5L10 4.5" stroke="#00B5E2" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        {%- render 'vertical-menu' -%}
      </div>

      <!-- Vertical Divider Line -->
      <div class="scrolled-header__divider" aria-hidden="true"></div>

      <!-- Main Navigation Menu -->
      <nav class="scrolled-header__nav" role="navigation">
        <ul class="scrolled-header__nav-list">
          {%- for link in linklists[main_menu_handle].links -%}
            {%- assign titleCheckMega = link.title | escape | split: '[' | first | split: '}' | last | downcase -%}
            {%- assign hasMega = false -%}
            {%- for i in (1..4) -%}
              {%- capture apmegamenu_title -%}apmenuitem_title_{{ i }}{%- endcapture -%}
              {%- assign megamenu_title = settings[apmegamenu_title] | escape | strip | downcase -%}
              {%- if titleCheckMega == megamenu_title -%}
                {%- assign hasMega = true -%}
                {%- assign intMega = i -%}
                {%- break -%}
              {%- endif -%}
            {%- endfor -%}

            {%- if hasMega -%}
              {%- assign isFullwidth = true -%}
              {%- assign settingWidth = 'apmenuitem_width_' | append: intMega -%}
              {%- assign widthMega = settings[settingWidth] -%}
              {%- if widthMega != 0 -%}{%- assign isFullwidth = false -%}{%- endif -%}

              <li class="scrolled-header__nav-item scrolled-header__nav-item--mega {% if link.active %}active{% endif %}">
                <a href="{{ link.url }}" class="scrolled-header__nav-link dropdown-toggle" {% if link.active %}aria-current="page"{% endif %}>
                  <span>{{ link.title | split: '[' | first | split: '{' | first }}</span>
                  <svg class="icon-dropdown-nav" width="8" height="5" viewBox="0 0 8 5" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M1 1L4 4L7 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
                <div class="scrolled-header__dropdown meganav meganav-{{ intMega }}" {%- if widthMega != 0 -%}style="width: {{ widthMega }}px;"{%- endif -%}>
                  {%- render 'megamenu', intMega: intMega -%}
                </div>
              </li>
            {%- elsif link.links != blank -%}
              <li class="scrolled-header__nav-item scrolled-header__nav-item--dropdown {% if link.active %}active{% endif %}">
                <a href="{{ link.url }}" class="scrolled-header__nav-link dropdown-toggle" {% if link.active %}aria-current="page"{% endif %}>
                  <span>{{ link.title | split: '[' | first | split: '{' | first }}</span>
                  <svg class="icon-dropdown-nav" width="8" height="5" viewBox="0 0 8 5" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M1 1L4 4L7 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
                <div class="scrolled-header__dropdown meganav">
                  {%- if titleCheckMega == 'industries' and industryBlocks.size > 0 -%}
                    {%- render 'industries-preview-menu', blocks: industryBlocks -%}
                  {%- else -%}
                    <ul class="meganav__nav">
                      {%- render 'site-nav', link: link -%}
                    </ul>
                  {%- endif -%}
                </div>
              </li>
            {%- else -%}
              <li class="scrolled-header__nav-item {% if link.active %}active{% endif %}">
                <a href="{{ link.url }}" class="scrolled-header__nav-link" {% if link.active %}aria-current="page"{% endif %}>
                  {{ link.title | split: '[' | first | split: '{' | first }}
                </a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </nav>
    </div>

    <!-- Right Section: Search Bar & Action Icons -->
    <div class="scrolled-header__right">
      <!-- Search Box -->
      <div class="scrolled-header__search">
        <form action="{{ routes.search_url }}" method="get" role="search" class="scrolled-header__search-form">
          <button type="submit" class="scrolled-header__search-btn" aria-label="Search">
            <svg class="scrolled-header__search-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#718096" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </button>
          <input
            type="search"
            name="q"
            class="scrolled-header__search-input"
            placeholder="Search by product code, model or specification"
            autocomplete="off"
            value="{{ search.terms | escape }}"
          >
          <input type="hidden" name="options[prefix]" value="last">
        </form>
      </div>

      <!-- Action Icons: Wishlist, Cart, Account -->
      <div class="scrolled-header__actions">
        <!-- Wishlist -->
        <div class="scrolled-header__action-item">
          <a href="/pages/{{ settings.page_wishlist | default: 'wishlist' }}" class="scrolled-header__action-btn" title="Wishlist" aria-label="Wishlist">
            <svg class="scrolled-header__icon-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
            <span class="scrolled-header__count num-wishlisted" style="display:none;">0</span>
          </a>
        </div>

        <!-- Cart -->
        <div class="scrolled-header__action-item header-cart">
          <a href="{{ routes.cart_url }}" class="scrolled-header__action-btn header__icon--cart scrolled-header-cart-icon" id="scrolled-cart-icon-bubble" title="Cart" aria-label="Cart">
            <svg class="scrolled-header__icon-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="9" cy="21" r="1"/>
              <circle cx="20" cy="21" r="1"/>
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
            </svg>
            <span class="scrolled-header__count scrolled-header__cart-count" id="scrolled-header-cart-count" style="{% if cart.item_count == 0 %}display:none !important;{% endif %}">
              <span aria-hidden="true">{{ cart.item_count }}</span>
            </span>
          </a>
          {% render 'mini-cart' %}
        </div>

        <!-- Account -->
        <div class="scrolled-header__action-item header-sign">
          <button class="show_login scrolled-header__action-btn" type="button" title="Account" aria-label="Account">
            <svg class="scrolled-header__icon-svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
              <circle cx="12" cy="7" r="4"/>
            </svg>
          </button>
          <div class="mini-acount">
            {% if customer %}
              <p><a>Hello {{ customer.first_name }}</a></p>
              <p><a href="{{ routes.account_logout_url }}" title="{{ 'layout.customer.log_out' | t }}" class="site-header__link">Logout</a></p>
              <p><a href="{{ routes.account_url }}" title="My account">My account</a></p>
            {% else %}
              <p><a href="{{ routes.account_login_url }}" class="site-header__link">Sign in</a></p>
              <p><a href="{{ routes.account_register_url }}" title="Register">Register</a></p>
            {% endif %}
            <p><a href="/pages/wishlist" title="Wishlist">Wishlist (<span class="js-wishlist-count"></span>)</a></p>
            <p><a href="/cart" title="Checkout">Checkout</a></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    function closeAllCategoryMenus() {
      var openMenus = document.querySelectorAll('.nav-vertical.show');
      if (openMenus.length > 0) {
        openMenus.forEach(function (m) {
          m.classList.remove('show');
        });
        document.body.classList.remove('has-menu-vertical');
      }
    }

    // 1. Outside click handler to close category menu
    document.addEventListener('click', function (e) {
      var isCatBtn = e.target.closest('.vertical-bars');
      var isCatMenu = e.target.closest('.nav-vertical');
      if (!isCatBtn && !isCatMenu) {
        closeAllCategoryMenus();
      }
    });

    // 2. Smooth Scroll state controller matching supmeaauto.com dual-threshold hysteresis
    var enterScrollPoint = 120;
    var leaveScrollPoint = 24;
    var isScrolled = false;
    var ticking = false;

    function getHeaders() {
      return document.querySelectorAll('.header-1, .header-2, .header-3, .header-4, .header-5, .header, .site-header, .header-section');
    }

    function updateNavbar() {
      var scrollTop = window.pageYOffset || document.documentElement.scrollTop || document.body.scrollTop || 0;
      var headers = getHeaders();

      if (!isScrolled && scrollTop >= enterScrollPoint) {
        headers.forEach(function (h) { h.classList.add('is-scrolled'); });
        document.body.classList.add('header-is-scrolled');
        isScrolled = true;
        closeAllCategoryMenus();
      } else if (isScrolled && scrollTop <= leaveScrollPoint) {
        headers.forEach(function (h) { h.classList.remove('is-scrolled'); });
        document.body.classList.remove('header-is-scrolled');
        isScrolled = false;
        closeAllCategoryMenus();
      }
      ticking = false;
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', updateNavbar);
    } else {
      updateNavbar();
    }

    window.addEventListener('scroll', function () {
      // Automatically close any open category menus on scroll
      var openMenus = document.querySelectorAll('.nav-vertical.show');
      if (openMenus.length > 0) {
        closeAllCategoryMenus();
      }

      if (!ticking) {
        window.requestAnimationFrame(updateNavbar);
        ticking = true;
      }
    }, { passive: true });

    // 3. Real-time Parallel Cart Count Synchronizer for Scrolled Header
    function updateScrolledCartCount(count) {
      var num = parseInt(count, 10);
      var badge = document.getElementById('scrolled-header-cart-count');
      if (!badge) {
        var cartBtn = document.querySelector('.scrolled-header-cart-icon, .scrolled-header__action-item.header-cart .scrolled-header__action-btn');
        if (cartBtn) {
          badge = document.createElement('span');
          badge.className = 'scrolled-header__count scrolled-header__cart-count';
          badge.id = 'scrolled-header-cart-count';
          badge.innerHTML = '<span aria-hidden="true">0</span>';
          cartBtn.appendChild(badge);
        }
      }
      if (badge) {
        var span = badge.querySelector('span') || badge;
        span.textContent = isNaN(num) ? count : num;
        if (!isNaN(num) && num > 0) {
          badge.style.setProperty('display', 'flex', 'important');
        } else {
          badge.style.setProperty('display', 'none', 'important');
        }
      }
    }
    window.updateScrolledHeaderCartCount = updateScrolledCartCount;

    // Observe changes to the static header's cart icon bubble (#cart-icon-bubble)
    function attachMainCartObserver() {
      var mainCartBubble = document.getElementById('cart-icon-bubble');
      if (mainCartBubble) {
        function syncFromMainHeaderCart() {
          var bubbleEl = mainCartBubble.querySelector('.cart-count-bubble');
          if (bubbleEl) {
            var countMatch = bubbleEl.textContent.trim().match(/\d+/);
            if (countMatch && countMatch[0]) {
              updateScrolledCartCount(countMatch[0]);
              return;
            }
          }
          // Fetch live /cart.js if main cart doesn't have an inline bubble
          fetch('/cart.js')
            .then(function (r) { return r.json(); })
            .then(function (cart) {
              if (cart && typeof cart.item_count !== 'undefined') {
                updateScrolledCartCount(cart.item_count);
              }
            })
            .catch(function () {});
        }

        var cartObserver = new MutationObserver(syncFromMainHeaderCart);
        cartObserver.observe(mainCartBubble, { childList: true, subtree: true, characterData: true });
        syncFromMainHeaderCart();
      } else {
        fetch('/cart.js')
          .then(function (r) { return r.json(); })
          .then(function (cart) {
            if (cart && typeof cart.item_count !== 'undefined') {
              updateScrolledCartCount(cart.item_count);
            }
          })
          .catch(function () {});
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', attachMainCartObserver);
    } else {
      attachMainCartObserver();
    }

    // Global listener for custom cart events
    document.addEventListener('cart:updated', function (e) {
      if (e.detail && typeof e.detail.item_count !== 'undefined') {
        updateScrolledCartCount(e.detail.item_count);
      }
    });

    // Intercept native fetch requests to /cart/* to update instantly in parallel
    if (window.fetch) {
      var _nativeFetch = window.fetch;
      window.fetch = function () {
        var promise = _nativeFetch.apply(this, arguments);
        var url = arguments[0];
        if (typeof url === 'string' && (
          url.indexOf('/cart/add') !== -1 ||
          url.indexOf('/cart/change') !== -1 ||
          url.indexOf('/cart/clear') !== -1 ||
          url.indexOf('/cart/update') !== -1
        )) {
          promise.then(function (res) {
            try {
              var clone = res.clone();
              clone.json().then(function (data) {
                if (data && typeof data.item_count !== 'undefined') {
                  updateScrolledCartCount(data.item_count);
                } else {
                  _nativeFetch('/cart.js')
                    .then(function (r) { return r.json(); })
                    .then(function (cart) {
                      if (cart && typeof cart.item_count !== 'undefined') {
                        updateScrolledCartCount(cart.item_count);
                      }
                    })
                    .catch(function () {});
                }
              }).catch(function () {});
            } catch (err) {}
          }).catch(function () {});
        }
        return promise;
      };
    }

    // Hook into any jQuery AJAX completions for cart updates
    if (window.jQuery) {
      jQuery(document).ajaxComplete(function (event, xhr, settings) {
        if (settings && settings.url && (
          settings.url.indexOf('/cart/add') !== -1 ||
          settings.url.indexOf('/cart/change') !== -1 ||
          settings.url.indexOf('/cart/update') !== -1 ||
          settings.url.indexOf('/cart.js') !== -1
        )) {
          try {
            var data = JSON.parse(xhr.responseText);
            if (data && typeof data.item_count !== 'undefined') {
              updateScrolledCartCount(data.item_count);
            } else if (window.Shopify && Shopify.getCart) {
              Shopify.getCart(function (c) { updateScrolledCartCount(c.item_count); });
            }
          } catch (err) {}
        }
      });
    }
  })();
</script>
