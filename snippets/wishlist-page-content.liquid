{{ 'wishlist.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}

{%- unless customer -%}
  {%- comment -%} Guests can't view the wishlist - the decision to redirect
  is made server-side here (via the customer object), the redirect itself
  just has to run in the browser since Liquid has no server redirect tag. {%- endcomment -%}
  <script>
    window.location.replace('{{ routes.account_login_url }}?return_url=' + encodeURIComponent(window.location.pathname + window.location.search));
  </script>
  <noscript>
    <meta http-equiv="refresh" content="0; url={{ routes.account_login_url }}">
  </noscript>
{%- endunless -%}

<style>
/* Ensure global breadcrumb bar is hidden on wishlist page (we render our own below) */
.g-breadcrumb,
nav.g-breadcrumb,
.breadcrumb.g-breadcrumb,
nav.breadcrumb,
.breadcrumbs-style_1,
.breadcrumbs-style_2 {
  display: none !important;
}

/* Wishlist Page - Grid of Product Cards */
.fk-wishlist-page {
  background-color: #ffffff;
  min-height: auto;
  padding: 0 0 60px;
  display: block;
  width: 100%;
  box-sizing: border-box;
}

/* Full-bleed breadcrumb bar */
.fk-wishlist-breadcrumb {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  width: 100%;
  box-sizing: border-box;
  background-color: #eaf5ff;
  padding: 26px 15px;
  margin: 0 0 30px 0;
  font-size: 14px;
  color: #5c6b7a;
}

.fk-wishlist-breadcrumb a {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: #5c6b7a;
  text-decoration: none;
  transition: color 0.2s ease;
}

.fk-wishlist-breadcrumb a:hover {
  color: #2874f0;
}

.fk-wishlist-breadcrumb svg {
  width: 15px;
  height: 15px;
  flex-shrink: 0;
}

.fk-wishlist-breadcrumb__separator {
  color: #8a97a6;
  display: inline-block;
}

.fk-wishlist-breadcrumb__current {
  color: #1c2b3f;
  font-weight: 600;
}

.fk-wishlist-container {
  width: 100%;
  box-sizing: border-box;
}

/* Card Grid */
.fk-wishlist-list {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 20px;
  width: 100%;
}

/* Single Wishlist Card */
.fk-wishlist-item {
  position: relative;
  display: flex;
  flex-direction: column;
  background-color: #ffffff;
  border: 1px solid #e5e8eb;
  border-radius: 6px;
  padding: 20px 18px 18px;
  box-sizing: border-box;
  transition: box-shadow 0.2s ease, opacity 0.25s ease, transform 0.25s ease;
}

.fk-wishlist-item:hover {
  box-shadow: 0 4px 14px 0 rgba(0, 0, 0, 0.06);
}

.fk-wishlist-item.removing {
  opacity: 0;
  transform: scale(0.96);
}

/* Remove (x) Button */
.fk-wishlist-item__remove {
  position: absolute;
  top: 10px;
  right: 10px;
  width: 24px;
  height: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #ffffff;
  border: 1px solid #e0e0e0;
  border-radius: 4px;
  color: #8a97a6;
  cursor: pointer;
  padding: 0;
  transition: all 0.2s ease;
  z-index: 2;
}

.fk-wishlist-item__remove svg {
  width: 12px;
  height: 12px;
}

.fk-wishlist-item__remove:hover {
  border-color: #e53935;
  color: #e53935;
  background-color: #fff5f5;
}

/* Product Image */
.fk-wishlist-item__image {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 180px;
  margin-bottom: 16px;
  text-decoration: none;
  overflow: hidden;
}

.fk-wishlist-item__image img {
  max-width: 100%;
  max-height: 100%;
  width: auto;
  height: auto;
  object-fit: contain;
  display: block;
  transition: transform 0.3s ease;
}

.fk-wishlist-item:hover .fk-wishlist-item__image img {
  transform: scale(1.03);
}

/* Title / SKU / Price */
.fk-wishlist-item__body {
  flex: 1;
}

.fk-wishlist-item__title {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-size: 15px;
  font-weight: 600;
  color: #1c2b3f;
  line-height: 1.4;
  margin: 0 0 6px 0;
  text-decoration: none;
}

.fk-wishlist-item__title:hover {
  color: #2874f0;
}

.fk-wishlist-item__sku {
  font-size: 12.5px;
  color: #8a97a6;
  margin-bottom: 10px;
}

.fk-wishlist-item__price {
  font-size: 16px;
  font-weight: 700;
  color: #1c2b3f;
  margin-bottom: 14px;
}

.fk-wishlist-item__status {
  font-size: 12px;
  font-weight: 600;
  color: #c2185b;
  margin-bottom: 10px;
}

/* Divider */
.fk-wishlist-item__divider {
  height: 1px;
  background-color: #eef0f2;
  margin: 0 -18px 12px;
}

/* Move to Bag */
.fk-wishlist-item__move {
  display: block;
  width: 100%;
  background: none;
  border: none;
  color: #2874f0;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.4px;
  text-transform: uppercase;
  text-align: center;
  cursor: pointer;
  padding: 4px 0 2px;
}

.fk-wishlist-item__move:hover {
  color: #1259cb;
  text-decoration: underline;
}

.fk-wishlist-item__move[disabled] {
  color: #c6ccd2;
  cursor: not-allowed;
  text-decoration: none;
}

/* Skeleton Loading State */
.fk-wishlist-skeleton-item {
  display: flex;
  flex-direction: column;
  background-color: #ffffff;
  border: 1px solid #e5e8eb;
  border-radius: 6px;
  padding: 20px 18px 18px;
  box-sizing: border-box;
}

.fk-wishlist-skeleton-box {
  background: #f1f3f6;
  border-radius: 4px;
  position: relative;
  overflow: hidden;
  display: block;
}

.fk-wishlist-skeleton-box::after {
  content: "";
  position: absolute;
  top: 0; right: 0; bottom: 0; left: 0;
  transform: translateX(-100%);
  background-image: linear-gradient(90deg, rgba(255,255,255,0) 0, rgba(255,255,255,0.7) 50%, rgba(255,255,255,0) 100%);
  animation: fkShimmer 1.5s infinite;
}

@keyframes fkShimmer {
  100% {
    transform: translateX(100%);
  }
}

/* Empty State */
.fk-wishlist-empty {
  padding: 60px 24px;
  text-align: center;
  background-color: #ffffff;
  display: none;
}

.fk-wishlist-empty.is-visible {
  display: block;
}

.fk-wishlist-empty__circle {
  width: 80px;
  height: 80px;
  margin: 0 auto 16px;
  border-radius: 50%;
  background-color: #f1f3f6;
  color: #878787;
  display: flex;
  align-items: center;
  justify-content: center;
}

.fk-wishlist-empty__title {
  font-size: 20px;
  font-weight: 600;
  color: #212121;
  margin-bottom: 8px;
  display: block;
}

.fk-wishlist-empty__text {
  font-size: 14px;
  color: #878787;
  margin-bottom: 24px;
  display: block;
}

.fk-wishlist-empty__btn {
  display: inline-block;
  background-color: #2874f0;
  color: #ffffff !important;
  font-size: 14px;
  font-weight: 600;
  padding: 12px 32px;
  border-radius: 2px;
  text-decoration: none !important;
  box-shadow: 0 2px 4px 0 rgba(0, 0, 0, 0.2);
  transition: background-color 0.2s ease;
}

.fk-wishlist-empty__btn:hover {
  background-color: #1259cb;
}

@media (max-width: 600px) {
  .fk-wishlist-breadcrumb {
    padding: 18px 15px;
  }
  .fk-wishlist-list {
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
  .fk-wishlist-item {
    padding: 14px 12px 12px;
  }
  .fk-wishlist-item__image {
    height: 110px;
    margin-bottom: 10px;
  }
  .fk-wishlist-item__title {
    font-size: 13px;
  }
  .fk-wishlist-item__price {
    font-size: 14px;
  }
  .fk-wishlist-item__divider {
    margin: 0 -12px 10px;
  }
}
</style>

<div class="fk-wishlist-page">
  <!-- Breadcrumb -->
  <nav class="fk-wishlist-breadcrumb" aria-label="breadcrumbs">
    <a href="/" title="Home">
      <svg aria-hidden="true" focusable="false" viewBox="0 0 576 512"><path fill="currentColor" d="M541 229.16l-61-49.83v-77.4a6 6 0 0 0-6-6h-20a6 6 0 0 0-6 6v51.33L308.19 39.14a32.16 32.16 0 0 0-40.38 0L35 229.16a8 8 0 0 0-1.16 11.24l10.1 12.41a8 8 0 0 0 11.2 1.19L96 220.62v243a16 16 0 0 0 16 16h128a16 16 0 0 0 16-16v-128l64 .3V464a16 16 0 0 0 16 16l128-.33a16 16 0 0 0 16-16V220.62L520.86 254a8 8 0 0 0 11.25-1.16l10.1-12.41a8 8 0 0 0-1.21-11.27zm-93.11 218.59h.1l-96 .3V319.88a16.05 16.05 0 0 0-15.95-16l-96-.27a16 16 0 0 0-16.05 16v128.14H128V194.51L288 63.94l160 130.57z"></path></svg>
      Home
    </a>
    <span class="fk-wishlist-breadcrumb__separator" aria-hidden="true">&rsaquo;</span>
    <span class="fk-wishlist-breadcrumb__current">Wishlist</span>
  </nav>

  <div class="fk-wishlist-container page-width">
    <product-wishlistpage>
      <!-- Active Wishlist Grid -->
      <div class="fk-wishlist-list" id="fk-wishlist-list" style="display: none;">
        <!-- Dynamically Rendered by wishlist.js -->
      </div>

      <!-- Skeleton Loading State -->
      <div class="fk-wishlist-list" id="fk-wishlist-skeleton">
        {%- for i in (1..4) -%}
        <div class="fk-wishlist-skeleton-item">
          <div class="fk-wishlist-skeleton-box" style="width: 100%; height: 180px; margin-bottom: 16px;"></div>
          <div class="fk-wishlist-skeleton-box" style="width: 85%; height: 16px; margin-bottom: 10px;"></div>
          <div class="fk-wishlist-skeleton-box" style="width: 40%; height: 20px; margin-bottom: 14px;"></div>
          <div class="fk-wishlist-skeleton-box" style="width: 100%; height: 14px;"></div>
        </div>
        {%- endfor -%}
      </div>

      <!-- Empty State -->
      <div class="fk-wishlist-empty" id="fk-wishlist-empty" style="display: none;">
        <div class="fk-wishlist-empty__circle">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
          </svg>
        </div>
        <h2 class="fk-wishlist-empty__title">Empty Wishlist</h2>
        <p class="fk-wishlist-empty__text">You have no items in your wishlist. Start adding!</p>
        <a href="/collections/all" class="fk-wishlist-empty__btn">Continue Shopping</a>
      </div>
    </product-wishlistpage>
  </div>
</div>
