{% if template contains 'cart' %}

{% else %}
<mini-cart>
  <div id="minicart" class="product-minincart">
    <!-- Header: Title, Count Badge, Close Button -->
    <div class="minicart-header">
      <div class="minicart-header__left">
        <h3 class="minicart-header__title">Cart</h3>
        <span class="minicart-header__badge" id="minicart-count-badge">
          {{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %}
        </span>
      </div>
      <button type="button" class="minicart-header__close" aria-label="Close cart">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M2 2L14 14M2 14L14 2" stroke="#64748b" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>

    <!-- Items List -->
    <div class="list-mimicart">
      {%- if cart.items.size == 0 -%}
        <div class="minicart-empty">
          <p>Your cart is empty.</p>
        </div>
      {%- else -%}
        {%- for item in cart.items -%}
          <div class="minicart-item" data-line="{{ forloop.index }}">
            {% if item.image %}
              <a class="image-product" href="{{ item.product.url }}">
                <img class="mimicart-item__image"
                     src="{{ item.image | img_url: '140x' }}"
                     alt="{{ item.image.alt | escape }}"
                     loading="lazy"
                >
              </a>
            {% endif %}
            <div class="minicart-item__info">
              <a href="{{ item.product.url }}" class="mimicart-item__name">{{ item.product.title | escape }}</a>
              {% if item.sku != blank %}
                <div class="minicart-item__sku">SKU : {{ item.sku }}</div>
              {% elsif item.variant.sku != blank %}
                <div class="minicart-item__sku">SKU : {{ item.variant.sku }}</div>
              {% elsif item.variant.title != 'Default Title' and item.variant.title != blank %}
                <div class="minicart-item__sku">{{ item.variant.title }}</div>
              {% endif %}

              <div class="minicart-item__bottom">
                <span class="minicart-item__price">
                  {{ item.original_price | money }}
                </span>

                <quantity-input class="quantity">
                  <button class="quantity__button no-js-hidden" name="minus" type="button" aria-label="Decrease">
                    &minus;
                  </button>
                  <input class="quantity__input"
                         type="number"
                         name="updates[]"
                         value="{{ item.quantity }}"
                         min="0"
                         aria-label="Quantity"
                         id="Quantity-{{ forloop.index }}"
                         data-index="{{ forloop.index }}"
                  >
                  <button class="quantity__button no-js-hidden" name="plus" type="button" aria-label="Increase">
                    &#43;
                  </button>
                </quantity-input>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    <!-- Footer: Proceed to checkout & Edit Cart -->
    <div class="bottom-minicart">
      <div class="cart__ctas">
        <a href="/checkout" class="cart__checkout-button button-checkout-cwa"{% if cart == empty %} style="pointer-events: none; opacity: 0.6;"{% endif %}>
          Proceed to checkout
        </a>
      </div>

      <div class="goto-cart">
        <a href="{{ routes.cart_url }}" class="minicart-edit-link">Edit Cart</a>
      </div>
    </div>
  </div>
</mini-cart>
<script src="{{ 'minicart.js' | asset_url }}" defer="defer"></script>
{% endif %}
