{%- if shop.customer_accounts_enabled -%}
        <a href="{%- if customer -%}https://shopify.com/77655081152/account/profile{%- else -%}/customer_authentication/login?return_to={{ routes.root_url | url_encode }}{%- endif -%}" class="header__icon header__icon--account link link--text focus-inset">
          {%- if customer -%}
            {%- assign customer_initial = customer.first_name | default: customer.name | default: customer.email | slice: 0, 1 | upcase -%}
            <span class="header-customer-initial">{{ customer_initial }}</span>
          {%- else -%}
            {% render 'icon-account' %}
          {%- endif -%}
          <span class="visually-hidden">
            {%- liquid
              if customer
                echo 'customer.account_fallback' | t
              else
                echo 'customer.log_in' | t
              endif
            -%}
          </span>
        </a>
      {%- endif -%}