{% layout none %}
{% paginate collection.products by 250 %}
{
  "page": {{ paginate.current_page }},
  "pages": {{ paginate.pages }},
  "items": {{ paginate.items }},
  "products": [
    {% for product in collection.products %}
      {%- assign product_code = product.metafields.custom.product_code.value | default: product.selected_or_first_available_variant.sku -%}
      {%- capture card_html -%}<li class="grid__item" data-product-id="{{ product.id }}">{% render 'product-card', product_card_product: product %}</li>{%- endcapture -%}
      {
        "id": {{ product.id | json }},
        "title": {{ product.title | json }},
        "handle": {{ product.handle | json }},
        "url": {{ product.url | json }},
        "price": {{ product.price | json }},
        "thumbnail": {{ product.featured_image.src | img_url: 'compact' | json }},
        "image": {{ product.featured_image.src | img_url: '533x' | json }},
        "product_code": {{ product_code | default: '' | json }},
        "vendor": {{ product.vendor | default: '' | json }},
        "specs": {
          "accuracy": {{ product.metafields.specs.accuracy | default: '' | json }},
          "size_range": {{ product.metafields.specs.size_range | default: '' | json }},
          "protection": {{ product.metafields.specs.protection | default: '' | json }}
        },
        "card_html": {{ card_html | json }}
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}
{% endpaginate %}
