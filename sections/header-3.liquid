<!-- header-3.liquid -->
{{ 'header-3.css' | asset_url | stylesheet_tag }}
{% render 'section-style' %}
{%- style -%}
  .header-3 .header-announcement_bar a,.header-3 .header-announcement_bar .signin-top{
    color:{{ section.settings.color_announcement }};
  }
  .header-3 .header-announcement_bar a:hover{
    color: var(--color-base-link-hover);
  }
  @media (max-width:992px){
    .header-3 .head-logo{
      padding:25px 30px;
    }
    
  }
{%- endstyle -%}
<header class="header-3 {%- if section.settings.enable_transparent -%}{{ 'color-transparent' | prepend: ' ' }}{%- endif -%}">
  <div class="{%- if section.settings.fullwidth -%}container-fluid{%- else -%}container larger-container{%- endif -%}">
    <div class="row">
      <div class="col-12 col-lg-2  d-flex align-items-center justify-content-center" style="background-color: {{ section.settings.bg_logo }};">
        <div class=" head-logo logo-align-{% if section.settings.logo_align_2 == 'left' %}left{% else %}center{% endif %}">
          {% render 'header-logo' %}
        </div>
      </div>
      <div class="col-12 col-lg-10 header-top">
        {%- if section.settings.enable_announcement_bar -%}
          <div class="header-announcement_bar d-none d-lg-block  {%- if section.settings.text_style_2 -%}{{ 'announcement_bar_text' | prepend: ' ' }}{%- endif -%} {%- if section.settings.border_announcement_bar -%}{{ 'announcement_bar_border' | prepend: ' ' }}{%- endif -%}" {%- if section.settings.bkg_announcement_bar != blank -%} style="background-color: {{ section.settings.bkg_announcement_bar }};"{%- endif -%}>
            <div class="{%- if section.settings.fullwidth -%}container-fluid{%- else -%}container larger-container{%- endif -%}">
                <div class="announcement-bar-box row ">
                  <div class="col-lg-5 col-xl-6 header-announcement_bar-item">
                    <div class="header-3-announcement-bar-left">
                      <p>{{ section.settings.text_announcement_bar_left }}</p>
                    </div>
                  </div>
                  <div class="col-lg-3 header-announcement_bar-item">
                    {%- if section.settings.header_seach -%}
                        {% render 'search-header' %}
                    {%- endif -%}
                  </div>
                  <div class="col-lg-4 col-xl-3 header-announcement_bar-item">
                    <div class="header-3-announcement-bar-right">
                      {%- if section.settings.currencies -%}
                          {%- render 'block-currencies' -%}
                      {%- endif -%}
                      {%- if section.settings.show_signin_top -%}
                      <div class="signin-top">
                        {% if customer %}
                          <p><a>Hello {{customer.first_name }}</a></p>
                            <p><a href="/account/logout" title="{{'layout.customer.log_out' | t}}" class="site-header__link">
                              Logout
                            </a>
                            </p>
                          <p><a href="https://shopify.com/77655081152/account/profile" title="My account">My account</a></p>
                          {%- else -%}
                            Welcome Guess!
                            <p><a href="/customer_authentication/login?return_to={{ routes.root_url | url_encode }}" class="site-header__link">Sign in</a></p>or
                            <p><a href="/customer_authentication/login?return_to={{ routes.root_url | url_encode }}" title="Register">Register</a></p>
                        {%- endif -%}
                      </div>
                      {%- endif -%}
                    </div>
                  </div>
                </div>
            </div>
          </div>
        {%- endif -%}
        <div class="{%- if section.settings.fullwidth -%}container-fluid{%- else -%}container{%- endif -%}">
            <div class="row">
                <div class="col-6 col-lg-8 col-xl-6 header-menubar header-align-{% if section.settings.logo_align_2 == 'left' %}center{% else %}left{% endif %}">
                  {%- render 'icon-megamenu-mobile' -%}
                  {%- render 'block-menu' -%}
                </div>
                <div class="col-6 col-lg-4 col-xl-6 header-icon ">
                  {%- if section.settings.phone_contact != blank -%}
                    <div class="phone-number d-none d-xl-block ">
                      {{ section.settings.phone_contact }}
                    </div>
                  {%- endif -%}
                  <div class="d-flex align-items-center justify-content-center">
                    {%- if section.settings.header_wishlist -%}
                      {% render 'wishlist-header' %}
                    {%- endif -%}

                    {%- if section.settings.header_sign -%}    
                      {%- render 'header-sign' -%}
                    {%- endif -%}

                    {%- if section.settings.header_card -%}
                        {%- render 'header-cart' -%}
                    {%- endif -%}
                  </div>
              </div>  
            </div>
        </div>
      </div>
    </div>
  </div>

  {%- render 'scrolled-header' -%}
</header>

{% schema %}
{
  "name": "t:sections.header-3.name",
  "class": "spaced-header",
  "tag": "section",
  "settings": [
      {
        "type": "checkbox",
        "id": "fullwidth",
        "label": "t:sections.header-3.settings.fullwidth.label",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "enable_transparent",
        "label": "t:sections.header-3.settings.enable_transparent.label"
      },
      {
        "type": "color",
        "id": "bg_logo",
        "label": "Background logo",
        "default":"#94be90"
      },
      {
        "type": "header",
        "content": "t:sections.header-3.settings.header.content"
      },
      {
        "type": "checkbox",
        "id": "enable_announcement_bar",
        "label": "t:sections.header-3.settings.enable_announcement_bar.label",
        "default": false
      },
      {
        "type": "color",
        "id": "color_announcement",
        "label": "Color text announcement",
        "default": "#999999"
      },
      {
        "type": "textarea",
        "id": "text_announcement_bar_left",
        "label": "t:sections.header-4.settings.text_announcement_bar.label",
        "default": "Welcome to our store"
      },
      {
        "type": "checkbox",
        "id": "show_signin_top",
        "label": "Show sign in header announcement bar",
        "default": true
      },
      {
        "id": "bkg_announcement_bar",
        "type": "color",
        "label": "t:sections.header-3.settings.bkg_announcement_bar.label"
      },
      {
        "type": "checkbox",
        "id": "text_style_2",
        "label": "t:sections.header-3.settings.text_style_2.label"
      },
      {
        "id": "border_announcement_bar",
        "type": "checkbox",
        "label": "t:sections.header-3.settings.border_announcement_bar.label",
        "default": false
      },
      {
        "type": "text",
        "id": "announcement_bar_text_left",
        "label": "t:sections.header-3.settings.announcement_bar_text_left.label",
        "default": "Need virtual style advice? / "
      },
      {
        "type": "text",
        "id": "announcement_bar_link_left",
        "label": "t:sections.header-3.settings.announcement_bar_link_left.label",
        "default": "+991 234 5647"
      },
      {
        "type": "text",
        "id": "announcement_bar_link1_right",
        "label": "t:sections.header-3.settings.announcement_bar_link1_right.label",
        "default": "SHOWROOMS"
      },
      {
        "type": "url",
        "id": "btn_link_1",
        "label": "t:sections.header-3.settings.btn_link_1.label"
      },
      {
        "type": "text",
        "id": "announcement_bar_link2_right",
        "label": "t:sections.header-3.settings.announcement_bar_link2_right.label",
        "default": "HELP CENTRE"
      },
      {
        "type": "url",
        "id": "btn_link_2",
        "label": "t:sections.header-3.settings.btn_link_2.label"
      },
      {
        "type": "checkbox",
        "id": "currencies",
        "label": "t:sections.header-3.settings.currencies.label",
        "default": true
      },
      {
        "type": "header",
        "content": "t:sections.header-3.settings.header_2.content"
      },
      {
        "id": "background-color",
        "type": "color",
        "label": "t:sections.header-3.settings.background-color.label"
      },
      {
        "id": "logo_align_2",
        "type": "select",
        "options": [
          {
            "value": "left",
            "label": "t:sections.header-3.settings.logo_align_2.options__1.label"
          },
          {
            "value": "center",
            "label": "t:sections.header-3.settings.logo_align_2.options__2.label"
          }
        ],
        "default": "left",
        "label": "t:sections.header-3.settings.logo_align_2.label"
      },
      {
        "type": "textarea",
        "id": "phone_contact",
        "label": "Phone contact",
        "default": "666 - 880 - 33388"
      },
      {
        "type": "checkbox",
        "id": "header_seach",
        "label": "t:sections.header-3.settings.header_seach.label",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "header_sign",
        "label": "t:sections.header-3.settings.header_sign.label",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "header_wishlist",
        "label": "t:sections.header-3.settings.header_wishlist.label",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "header_card",
        "label": "t:sections.header-3.settings.header_card.label",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "header_category",
        "label": "t:sections.header-3.settings.header_category.label",
        "default": true
      }
      ]
}
{% endschema %}