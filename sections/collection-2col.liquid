<!-- collection-2col.liquid -->

{{ 'collection-2row.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{% render 'section-style' %}
{%- style -%}
.collection-2row .sub-title{
  color:{{section.settings.color_sub_title }};
  display:flex;
  align-items:center;
  justify-content:center;
}
.collection-2row .sub-title span{
  border-top:1px solid {{section.settings.color_sub_title }};
}
{%- endstyle -%}
<div class="collection-1 collection-2row">
    <div class="{%- if section.settings.fullwidth -%}container-fluid{%- else -%}container{%- endif -%}">
      <div class="{% if section.settings.style_heading == 'column' %}heading-title text-center{% elsif section.settings.style_heading == 'row' %}heading{% endif %}"> 
        <p class="sub-title">{{ section.settings.sub_title }}</p>
        <h2 class="section-header">{{ section.settings.heading | escape }}</h2>
        <p class="section-text">{{ section.settings.text_decoration }}</p>
        {%- if section.settings.btn_text != blank -%}
            <a class="link-base" href="{{ section.settings.btn_link | default:'#' }}" title="{{ section.settings.btn_text }}">{{ section.settings.btn_text }}
              <i class="leofar leofa-arrow-right"></i>
            </a>
        {%- endif -%}
      </div>
        <div class="row collection-1-row">
            
            <div class="col-lg-6">
              {%- for block in section.blocks -%}
              {% case block.type %}
                {% when 'collectionleft' %}
                  <div class="collection-1-content collection-left" id="collection-{{ block.id }}">
                    {%- style -%}
                      .collection-2row #collection-{{ block.id }} .link-base{
                        background-color:{{ block.settings.bg_button }};
                        color:{{ block.settings.color_button }};
                        border: 1px solid {{ block.settings.border_button }};
                      }
                      .collection-2row #collection-{{ block.id }} .link-base:hover{
                        background-color:{{ block.settings.bg_button_hover }};
                        color:{{ block.settings.color_button_hover }};
                        border: 1px solid {{ block.settings.border_button_hover }};
                      }
                    {%- endstyle -%}
                      <a class="link-collection-1" href="{{ block.settings.collection.url | default:'#' }}">
                        <div class="collection-content collection-{% if section.settings.effects_image %}image-hover{% else %}image{% endif %} {% if block.settings.image_collection != blank %}media{% else %}image-collection__media--placeholder placeholder{% endif %}" style="padding-bottom: {{ 1 | divided_by: block.settings.image_collection.aspect_ratio | times: 100 }}%;" >
                          {%- if block.settings.image_collection != blank -%}
                          <img
                          srcset="{%- if block.settings.image_collection.width >= 165 -%}{{ block.settings.image_collection | img_url: '165x' }} 165w,{%- endif -%}
                            {%- if block.settings.image_collection.width >= 360 -%}{{ block.settings.image_collection | img_url: '360x' }} 360w,{%- endif -%}
                            {%- if block.settings.image_collection.width >= 535 -%}{{ block.settings.image_collection | img_url: '535x' }} 535w,{%- endif -%}
                            {%- if block.settings.image_collection.width >= 750 -%}{{ block.settings.image_collection | img_url: '750x' }} 750w,{%- endif -%}
                            {%- if block.settings.image_collection.width >= 1070 -%}{{ block.settings.image_collection | img_url: '1070x' }} 1070w,{%- endif -%}
                            {%- if block.settings.image_collection.width >= 1500 -%}{{ block.settings.image_collection | img_url: '1500x' }} 1500w,{%- endif -%}"
                          src="{{ block.settings.image_collection | img_url: 'master' }}"
                          sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px, (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2)"
                          alt="{{ block.settings.image_collection.alt | escape }}"
                          loading="lazy"
                          width="{{ block.settings.image_collection.width }}"
                          height="{{ block.settings.image_collection.height }}"
                        >
                        {%- else -%}
                        {%- capture current -%}{%- cycle 1, 2, 3, 4, 5, 6 -%}{%- endcapture -%}
                        {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                        {%- endif -%}
                        </div>
                        <div class="collection-text-content {%- if block.settings.align_text == 'top' -%}{{ 'top' | prepend: ' ' }}{%- else -%}{{ 'bottom' | prepend: ' ' }}{%- endif -%}">
                          {%- if block.settings.show_name_collection -%}
                          <h3 class="title-collection-1">{{ block.settings.collection.title | escape }}{%- if block.settings.collection.title == blank -%}<span>Collection</span>{%- endif -%}</h3>
                          {%- endif -%}
                          {%- if block.settings.description != blank -%}
                            <p class="description-collection-1">{{ block.settings.description }}</p>
                          {%- endif -%}
                          {%- if block.settings.show_count_item -%}
                          <div class="count"><span>{{ block.settings.collection.products_count | escape }} </span>products <i class="leofar leofa-arrow-right"></i></div>
                          {%- endif -%}
                          {%- if block.settings.btn_text_count != blank -%}
                            <div class="cat-button">
                              <a class="link-base" href="{{ block.settings.btn_link_count | default:'#' }}" title="{{ block.settings.btn_text_count }}">{% if block.settings.show_name_button %}{{ block.settings.collection.title | escape }}{% else %}{{ block.settings.btn_text_count }}{% endif %}
                                <i class="leofar leofa-arrow-right"></i>
                              </a>
                            </div>
                          {%- endif -%}
                        </div>
                    </a>
                  </div>   
              {% endcase %}
              {%- endfor -%}
            </div>
            <div class="col-lg-6">
              <div class="row">
              {%- for block in section.blocks -%}
              {%- case block.settings.width -%}
              {%- when '16%' -%}
              {%- assign block_width = 'col-lg-2 col-md-4 col-6' -%}
              {%- when '25%' -%}
              {%- assign block_width = 'col-lg-3 col-sm-6' -%}
              {%- when '33%' -%}
              {%- assign block_width = 'col-lg-4 col-sm-6' -%}
              {%- when '50%' -%}
              {%- assign block_width = 'col-lg-6' -%}
              {%- when '66%' -%}
              {%- assign block_width = 'col-lg-8 col-sm-6' -%}
              {%- when '75%' -%}
              {%- assign block_width = 'col-lg-9 col-sm-6' -%}
              {%- when '100%' -%}
              {%- assign block_width = 'col-12' -%}
              {%- endcase -%}
              {% case block.type %}
                 {% when 'collection' %}  
                  <div class="{{block_width}}">
                  
                    <div class="collection-1-content" id="collection-{{ block.id }}">
                      {%- style -%}
                      .collection-2row #collection-{{ block.id }} .link-base{
                        background-color:{{ block.settings.bg_button }};
                        color:{{ block.settings.color_button }};
                        border: 1px solid {{ block.settings.border_button }};
                      }
                      .collection-2row #collection-{{ block.id }} .link-base:hover{
                        background-color:{{ block.settings.bg_button_hover }};
                        color:{{ block.settings.color_button_hover }};
                        border: 1px solid {{ block.settings.border_button_hover }};
                      }
                    {%- endstyle -%}
                        <a class="link-collection-1" href="{{ block.settings.collection.url | default:'#' }}">
                          <div class="collection-content collection-{% if section.settings.effects_image %}image-hover{% else %}image{% endif %} {% if block.settings.image_collection != blank %}media{% else %}image-collection__media--placeholder placeholder{% endif %}" style="padding-bottom: {{ 1 | divided_by: block.settings.image_collection.aspect_ratio | times: 100 }}%;" >
                            {%- if block.settings.image_collection != blank -%}
                            <img
                            srcset="{%- if block.settings.image_collection.width >= 165 -%}{{ block.settings.image_collection | img_url: '165x' }} 165w,{%- endif -%}
                              {%- if block.settings.image_collection.width >= 360 -%}{{ block.settings.image_collection | img_url: '360x' }} 360w,{%- endif -%}
                              {%- if block.settings.image_collection.width >= 535 -%}{{ block.settings.image_collection | img_url: '535x' }} 535w,{%- endif -%}
                              {%- if block.settings.image_collection.width >= 750 -%}{{ block.settings.image_collection | img_url: '750x' }} 750w,{%- endif -%}
                              {%- if block.settings.image_collection.width >= 1070 -%}{{ block.settings.image_collection | img_url: '1070x' }} 1070w,{%- endif -%}
                              {%- if block.settings.image_collection.width >= 1500 -%}{{ block.settings.image_collection | img_url: '1500x' }} 1500w,{%- endif -%}"
                            src="{{ block.settings.image_collection | img_url: 'master' }}"
                            sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px, (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2)"
                            alt="{{ block.settings.image_collection.alt | escape }}"
                            loading="lazy"
                            width="{{ block.settings.image_collection.width }}"
                            height="{{ block.settings.image_collection.height }}"
                          >
                          {%- else -%}
                          {%- capture current -%}{%- cycle 1, 2, 3, 4, 5, 6 -%}{%- endcapture -%}
                          {{ 'collection-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                          {%- endif -%}
                          </div>
                          <div class="collection-text-content {%- if block.settings.align_text == 'top' -%}{{ 'top' | prepend: ' ' }}{%- else -%}{{ 'bottom' | prepend: ' ' }}{%- endif -%}">
                            {%- if block.settings.show_name_collection -%}
                            <h3 class="title-collection-1">{{ block.settings.collection.title | escape }}{%- if block.settings.collection.title == blank -%}<span>Collection</span>{%- endif -%}</h3>
                            {%- endif -%}
                            {%- if block.settings.description != blank -%}
                              <p class="description-collection-1">{{ block.settings.description }}</p>
                            {%- endif -%}
                            {%- if block.settings.show_count_item -%}
                            <div class="count"><span>{{ block.settings.collection.products_count | escape }} </span>products <i class="leofar leofa-arrow-right"></i></div>
                            {%- endif -%}
                            {%- if block.settings.btn_text_count != blank -%}
                              <div class="cat-button">
                                <a class="link-base" href="{{ block.settings.btn_link_count | default:'#' }}" title="{{ block.settings.btn_text_count }}">{% if block.settings.show_name_button %}{{ block.settings.collection.title | escape }}{% else %}{{ block.settings.btn_text_count }}{% endif %}
                                  <i class="leofar leofa-arrow-right"></i>
                                </a>
                              </div>
                            {%- endif -%}
                        </div>
                      </a>
                    </div>
                    
                  </div> 
              {% endcase %}
              {%- endfor -%}               
            </div>
            </div>
        </div>
    </div>
</div>
