<!-- advanced-content.liquid -->

{{ 'advanced-content.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{% render 'section-style' %}

<div class="advanced-content">
  <div class="{%- if section.settings.fullwidth -%}container-fluid{%- else -%}container{%- endif -%}">
    <h2 class="section-header">{{ section.settings.heading | escape }}</h2>
    <p class="section-text">{{ section.settings.text_decoration }}</p>

    <div class="row">
      {%- for block in section.blocks -%}
        {%- case block.settings.width -%}
        {%- when '25%' -%}
        {%- assign block_width = 'col-lg-3 col-lg-3 col-md-6' -%}
        {%- when '33%' -%}
        {%- assign block_width = 'col-xl-4 col-lg-5 col-md-6' -%}
        {%- when '50%' -%}
        {%- assign block_width = 'col-lg-6 col-md-6' -%}
        {%- when '66%' -%}
        {%- assign block_width = 'col-xl-8 col-lg-7 col-md-7' -%}
        {%- when '75%' -%}
        {%- assign block_width = 'col-lg-9 col-md-9' -%}
        {%- when '100%' -%}
        {%- assign block_width = 'col-12' -%}
        {%- endcase -%}
        <div class="{{block_width}} advanced-item pl-0">
          {%- case block.type -%}
            {%- when 'product_singer' -%}
                <div class="product-singer product-singer-{{block.id}}">
                  {%- style -%}
                    .product-singer-{{block.id}} .link-base{
                      background-color:{{ block.settings.bg_button }};
                      color:{{ block.settings.color_button }};
                      border: 1px solid {{ block.settings.border_button }};
                    }
                    .product-singer-{{block.id}} .link-base:hover{
                      background-color:{{ block.settings.bg_button_hover }};
                      color:{{ block.settings.color_button_hover }};
                      border: 1px solid {{ block.settings.border_button_hover }};
                    }
                  {%- endstyle -%}
                  <div class="product-title">
                    <h2 class="section-header">{{ block.settings.heading  }}</h2>
                    <p class="section-text">{{ block.settings.text_decoration }}</p>
                    
                    {%- assign product = block.settings.product -%}
                    <div class="product-box">
                      <div class="grid__item product__media-wrapper">
                        <a class="skip-to-content-link button visually-hidden" href="#ProductInfo-{{ section.id }}">
                          {{ "accessibility.skip_to_product_info" | t }}
                        </a>
                        <div class="product__media-list">
                          {%- if product.selected_or_first_available_variant.featured_media != null -%}
                            {%- assign media = product.selected_or_first_available_variant.featured_media -%}
                            <div class="product__media-item" data-media-id="{{ section.id }}-{{ media.id }}">
                              {% render 'product-thumbnail', media: media, position: 'featured', loop: section.settings.enable_video_looping, modal_id: section.id, xr_button: false %}
                            </div>
                          {%- endif -%}
                          {%- liquid
                            assign media_to_render = product.featured_media.id
                            for variant in product.variants
                              assign media_to_render = media_to_render | append: variant.featured_media.id | append: ' '
                            endfor
                          -%}
                          {%- for media in product.media -%}
                            {%- if media_to_render contains media.id and media.id != product.selected_or_first_available_variant.featured_media.id -%}
                              <div class="product__media-item" data-media-id="{{ section.id }}-{{ media.id }}">
                                {% render 'product-thumbnail', media: media, position: forloop.index, loop: section.settings.enable_video_looping, modal_id: section.id, xr_button: false %}
                              </div>
                            {%- endif -%}
                          {%- endfor -%}
                        </div>
                        {%- if first_3d_model -%}
                          <button
                            class="button button--full-width product__xr-button"
                            type="button"
                            aria-label="{{ 'products.product.xr_button_label' | t }}"
                            data-shopify-xr
                            data-shopify-model3d-id="{{ first_3d_model.id }}"
                            data-shopify-title="{{ product.title | escape }}"
                            data-shopify-xr-hidden
                          >
                            {% render 'icon-3d-model' %}
                            {{ 'products.product.xr_button' | t }}
                          </button>
                        {%- endif -%}
                      </div>
                      <div class="product-info">
                        <h2 class="h1 product__title" {{ block.shopify_attributes }}>
                          {%- if product.title != blank -%}
                            {{ product.title | escape }}
                          {%- else -%}
                            {{ 'onboarding.product_title' | t }}
                          {%- endif -%}
                        </h2>
                        <!-- rating -->
                        {% if product.metafields.reviews.rating.value %}
                        {% capture price_1 %}{{ product.metafields.reviews.rating.value }}{% endcapture %}
                        {% liquid
                                assign rating_decimal = 0
                                
                                assign decimal = price_1 | modulo: 1 
                                
                                if decimal >= 0.3 and decimal <= 0.7
                                  assign rating_decimal = 0.5
                                elsif decimal > 0.7
                                  assign rating_decimal = 1
                                endif 
                            %}

                            <div class="rating" role="img" aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: product.metafields.reviews.rating.value}}">
                                <span aria-hidden="true" class="rating-star color-icon-{{ settings.accent_icons }}" style="--rating: {{ product.metafields.reviews.rating.value.rating | floor }}; --rating-max: {{ product.metafields.reviews.rating.value.scale_max }}; --rating-decimal: {{ rating_decimal }};"></span>
                              </div>
                              <p class="rating-text caption">
                                <span aria-hidden="true">{{ product.metafields.reviews.rating.value }} / {{ product.metafields.reviews.rating.value.scale_max }}</span>
                              </p>
                              <p class="rating-count caption">
                                <span aria-hidden="true">({{ product.metafields.reviews.rating_count }})</span>
                                <span class="visually-hidden">{{ product.metafields.reviews.rating_count }} {{ "accessibility.total_reviews" | t }}</span>
                              </p>

                          {%- else -%}
                          <div class="rating" role="img" aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: product.metafields.reviews.rating.value}}">
                                <span aria-hidden="true" class="disable-rating-star rating-star color-icon-{{ settings.accent_icons }}" style="--rating: {{ product.metafields.reviews.rating.value.rating | floor }}; --rating-max: {{ product.metafields.reviews.rating.value.scale_max }}; --rating-decimal: {{ rating_decimal }};"></span>
                              </div>
                              <p class="rating-text caption">
                                <span aria-hidden="true">(0)</span>
                              </p>
                              <p class="rating-count caption">
                                <span aria-hidden="true">(0)</span>
                                <span class="visually-hidden">{{ product.metafields.reviews.rating_count }} {{ "accessibility.total_reviews" | t }}</span>
                              </p>
                        {% endif %}
                        <!-- price -->
                        <div class="no-js-hidden" id="price-{{ section.id }}" {{ block.shopify_attributes }}>
                          {%- render 'price', product: product, use_variant: true, show_badges: true, price_class: 'price--large' -%}
                        </div>
                        {%- if product != blank -%}
                          <div {{ block.shopify_attributes }}>
                            {%- form 'product', product -%}
                              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                              {{ form | payment_terms }}
                            {%- endform -%}
                          </div>
                        {%- endif -%}
                      </div>
                    </div>
                    

                    <p class="content-text">{{ block.settings.text_content }}</p>
                    {%- if block.settings.link != blank -%}
                      <a class="link-base">
                          {{ block.settings.link }}
                          <i class="leofar leofa-arrow-right"></i>
                      </a>
                    {%- endif -%}
                  
                  </div>
                  
                </div>


              {%- when 'image' -%}
              <div class="advanced-image h-100">
                  <div class="advanced-image-content h-100">
                  {%- if block.settings.image != blank -%}
                    <div class="advanced-image-{% if block.settings.effects_image %}blog{% else %}media{% endif %} {% if block.settings.image2 != blank  %} image-item {% endif %} w-100"
                     
                    >
                      <img class="advanced__image"
                      srcset="{%- if block.settings.image.width >= 165 -%}{{ block.settings.image | img_url: '165x' }} 165w,{%- endif -%}
                        {%- if block.settings.image.width >= 360 -%}{{ block.settings.image | img_url: '360x' }} 360w,{%- endif -%}
                        {%- if block.settings.image.width >= 480 -%}{{ block.settings.image | img_url: '480x' }} 480w,{%- endif -%}
                        {%- if block.settings.image.width >= 850 -%}{{ block.settings.image | img_url: '850x' }} 850w,{%- endif -%}
                        {%- if block.settings.image.width >= 1200 -%}{{ block.settings.image | img_url: '1300x' }} 1300w,{%- endif -%}
                        {%- if block.settings.image.width >= 1500 -%}{{ block.settings.image | img_url: '1500x' }} 1500w,{%- endif -%}"
                      src="{{ block.settings.image | img_url: 'master' }}"
                      sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px, (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2)"
                      alt="{{ block.settings.image.alt | escape }}"
                      loading="lazy"
                      width="{{ block.settings.image.width }}"
                      height="{{ block.settings.image.height }}"
                    >
                    </div>
                  {%- else -%}
                      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                  {%- if block.settings.image != blank and block.settings.image2 != blank -%}
                    <div class="d-none d-lg-block advanced-image-{% if block.settings.effects_image %}blog{% else %}media{% endif %} image-item">

                      <img class="advanced__image" src="{{  block.settings.image2 | img_url: 'master' }}" alt="">
                    </div>
                  {%- endif -%}
                  </div>
              </div>

              {%- when 'collection'-%}
              <div class="advanced-content-card {% if block.settings.image_collection != blank %}media{% else %}image-advanced__media--placeholder placeholder{% endif %}" style="padding-bottom: {{ 1 | divided_by: block.settings.image_collection.aspect_ratio | times: 100 }}%;" >
                <a href="{{ block.settings.collection.url | default:'#' }}">
                  {%- if block.settings.image_collection != blank -%}
                  <img
                      srcset="{%- if block.settings.image_collection.width >= 165 -%}{{ block.settings.image_collection | img_url: '165x' }} 165w,{%- endif -%}
                        {%- if block.settings.image_collection.width >= 360 -%}{{ block.settings.image_collection | img_url: '360x' }} 360w,{%- endif -%}
                        {%- if block.settings.image_collection.width >= 535 -%}{{ block.settings.image_collection | img_url: '535x' }} 535w,{%- endif -%}
                        {%- if block.settings.image_collection.width >= 750 -%}{{ block.settings.image_collection | img_url: '750x' }} 750w,{%- endif -%}
                        {%- if block.settings.image_collection.width >= 1070 -%}{{ block.settings.image_collection | img_url: '1070x' }} 1070w,{%- endif -%}
                        {%- if block.settings.image_collection.width >= 1500 -%}{{ block.settings.image_collection | img_url: '1500x' }} 1500w,{%- endif -%}"
                      src="{{ block.settings.image_collection | img_url: 'master' }}"
                      sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px, (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2)"
                      alt="{{ block.settings.image_collection.alt | escape }}"
                      loading="lazy"
                      width="{{ block.settings.image_collection.width }}"
                      height="{{ block.settings.image_collection.height }}"
                    >
                  <h3 class="title-collection">{{ block.settings.collection.title | escape }}</h3>
                  {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  <h3 class="collection-title">Collection</h3>
                  {%- endif -%}
                </a>
              </div>


              {%- when 'product'-%}
              <div class="advanced-product advanced-product-{{ block.id }}">
                {%- style -%}
                    .advanced-product-{{ block.id }} .link-base{
                      background-color:{{ block.settings.bg_button }};
                      color:{{ block.settings.color_button }};
                      border: 1px solid {{ block.settings.border_button }};
                    }
                    .advanced-product-{{ block.id }} .link-base:hover{
                      background-color:{{ block.settings.bg_button_hover }};
                      color:{{ block.settings.color_button_hover }};
                      border: 1px solid {{ block.settings.border_button_hover }};
                    }
                  {%- endstyle -%}
                  <p class="section-text" style="color:{{ block.settings.color_sub }} ;">{{ block.settings.text_decoration }}</p>
                <h2 class="section-header" style="color:{{ block.settings.color_head }}">{{ block.settings.heading  }}</h2>
                
                <div class="advanced-product-carousel slide-slick ap-custom-slick apslick"
                data-setting='{"accessibility": false, "arrows": {{ block.settings.arrows }},
                "dots": {{ block.settings.dots }}, "draggable": {{ block.settings.draggable }},
                "infinite": {{ block.settings.infinite }}, "autoplay": {{ block.settings.autoplay }},
                "autoplaySpeed": {{ block.settings.autoplaySpeed }}, "speed": {{ block.settings.speed }},
                "slidesToShow": {{ block.settings.slidesToShow }}, "slidesToScroll": {{ block.settings.slidesToScroll }},
                "vertical": false, "mobileFirst": false, "pauseOnHover": {{ block.settings.pauseOnHover }},
                "rows": {{ block.settings.rows }}, "slidesPerRow": 1, "rtl": 1,
                "slidesToShow_992": {{ block.settings.slidesToShow_992 }}, "slidesToScroll_992": {{ block.settings.slidesToScroll_992 }},
                "arrows_992": {{ block.settings.arrows_992 }}, "dots_992": {{ block.settings.dots_992 }},
                "slidesToShow_767": {{ block.settings.slidesToShow_767 }}, "slidesToScroll_767": {{ block.settings.slidesToScroll_767 }},
                "arrows_767": {{ block.settings.arrows_767 }}, "dots_767": {{ block.settings.dots_767 }},
                "slidesToShow_450": {{ block.settings.slidesToShow_450 }}, "slidesToScroll_450": {{ block.settings.slidesToScroll_450 }},
                "arrows_450": {{ block.settings.arrows_450 }}, "dots_450": {{ block.settings.dots_450 }}}'>
                    {%- for product in block.settings.collection.products -%}
                      <div class="items-product">
                        {%- if block.settings.collection.products.size == 1 -%}
                        {% render 'product-card',
                          product_card_product: product,
                          media_size: block.settings.image_ratio,
                          show_secondary_image: block.settings.show_secondary_image,
                          add_image_padding: block.settings.add_image_padding,
                          show_vendor: block.settings.show_vendor
                        %}
                        {%- else -%}
                        {% render 'product-card',
                          product_card_product: product,
                          media_size: block.settings.image_ratio,
                          show_secondary_image: block.settings.show_secondary_image,
                          add_image_padding: block.settings.add_image_padding,
                          show_vendor: block.settings.show_vendor
                        %}
                        {%- endif -%}
                      </div>
                    {%- endfor -%}
                    {%- if block.settings.collection == blank -%}
                        {%- for i in (1..6) -%}
                        <li class="product-items">
                          {%- capture current -%}{%- cycle 1, 2, 3, 4, 5, 6 -%}{%- endcapture -%}
                          {{ 'product-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
                        </li>
                        {%- endfor -%}
                    {%- endif -%}
                </div>
                <p class="content-text" style="color:{{ block.settings.color_content }}">{{ block.settings.text_content }}</p>
                    {%- if block.settings.link != blank -%}
                      <a class="link-base">
                          {{ block.settings.link }}
                          <i class="leofar leofa-arrow-right"></i>
                      </a>
                    {%- endif -%}
              </div>

              {%- when 'text_list'-%}
              <div id="advanced-{{ block.id }}" class="h-100 d-flex align-items-center text-list pe-0">
                <div class="advanced-content_text text-{%- if block.settings.text_align == 'left' -%}start{%- elsif block.settings.text_align == 'center' -%}center{%- elsif block.settings.text_align == 'right' -%}end{%- endif -%}">
                  {%- style -%}
                    .advanced-content #advanced-{{ block.id }} .link-base{
                      background-color:{{ block.settings.bg_button }};
                      color:{{ block.settings.color_button }};
                      border: 1px solid {{ block.settings.border_color }};
                    } 
                    .advanced-content #advanced-{{ block.id }} .section-text,.advanced-content #advanced-{{ block.id }} .text-list-note ul li{
                      color:{{ block.settings.color_text_note }};
                    }
                  {%- endstyle -%} 
  
                  {%- if block.settings.image_title != blank -%}
                    <div class="image-title-text-list">
                      <img src="{{ block.settings.image_title | img_url: 'master' }}" alt="">
                    </div>
                    {%- endif -%}
                    <div class="sub-title">
                      {{ block.settings.sub_title }}
                    </div>
                    <h3 class="text-start section-header">{{ block.settings.header__text }}</h3>
                    <div class="d-flex flex-column flex-lg-row">
                      <div class="text-left">
                        <p class="text-start section-text">{{ block.settings.text__content }}</p>
                        {%- if block.settings.btn_text != blank -%}
                            <a class="link-base" href="{{ block.settings.btn_link | default:'#' }}" title="{{ block.settings.btn_text }}">{{ block.settings.btn_text }}
                              <i class="leofar leofa-arrow-right"></i>
                            </a>
                        {%- endif -%}
                      </div>
                      {%- if block.settings.text_list_note != blank -%}
                        <div class="text-list-note w-lg-50">
                          <ul>
                            {{ block.settings.text_list_note }}
                          </ul>
                        </div>
                      {%- endif -%}
                    </div>

                    
                </div>
              </div>


              {%- when 'html'-%}
                {{ block.settings.html__text }}
                {%- when 'newsletter' -%}
                {%- style -%}
                    .advanced-newsletter-box .button-newsletter{
                      background-color:{{ block.settings.bg_button }};
                      border:{{ block.settings.border_color }};
                      color:{{ block.settings.color_button }};
                      box-shadow:none;
                      border-radius:5px;
                    }
                    .advanced-newsletter-box .button-newsletter:hover{
                      background-color:{{ block.settings.bg_button_hover }};
                      border:{{ block.settings.border_color_hover }};
                      color:{{ block.settings.color_button_hover }};
                      box-shadow:none;
                    }
                {%- endstyle -%}
                <div class="advanced-newsletter-box" style="background-image: url({{ block.settings.bg_advan_newsletter | img_url:'master' }});">
                    <div class="advanced-newsletter">
                    <p class="advanced-content_text-content">{{ block.settings.text_decoration }}</p>
                    <h3 class="advanced-content_text-title">{{ block.settings.header__text }}</h3>
                    <p class="section-text ">{{ block.settings.text__content }}</p>
                    {%- form 'contact', id: 'ContactForm' -%}
                      <div class="contact__fields">
                        <!-- name -->
                      <div class="field">
                          <input class="field__input" autocomplete="name" type="text" id="ContactForm-name" name="contact[{{ 'templates.contact.form.name' | t }}]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" placeholder="{{ 'templates.contact.form.name' | t }}">
                          <label class="field__label" for="ContactForm-name">Your name</label>
                      </div>
                      <!-- email -->
                      <div class="field field--with-error">
                          <input
                          autocomplete="email"
                          type="email"
                          id="ContactForm-email"
                          class="field__input"
                          name="contact[email]"
                          spellcheck="false"
                          autocapitalize="off"
                          value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                          aria-required="true"
                          {% if form.errors contains 'email' %}
                              aria-invalid="true"
                              aria-describedby="ContactForm-email-error"
                          {% endif %}
                          placeholder="Email address"
                          >
                          <label class="field__label" for="ContactForm-email">Email address <span aria-hidden="true">*</span></label>
                          {%- if form.errors contains 'email' -%}
                          <small class="contact__field-error" id="ContactForm-email-error">
                              <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
                              <span class="form__message">{% render 'icon-error' %}{{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}</span>
                          </small>
                          {%- endif -%}
                      </div>
                      </div>
                      <!-- button -->
                      <div class="contact__button">
                        <button type="submit" class="button button-newsletter">
                            {{ block.settings.label_button_newsletter }}
                            <i class="leofar leofa-arrow-right"></i>
                        </button>
                      </div>
                  {%- endform -%}
                  </div>
                </div>
               


              {%- when 'banner' -%}
              <div class="banner-normal" style=" background-color:{{ block.settings.bg_color }};background-image:url({{ block.settings.bg_banner | img_url:'master' }});">
                <div class="{%- if block.settings.fullwidth -%}container-fluid{%- else -%}larger-container{%- endif -%}">
                    <div class="text-banner d-flex flex-column justify-content-{% if block.settings.item_align == 'top' %}start{% elsif block.settings.item_align == 'center' %}center{% elsif block.settings.item_align == 'bottom' %}end{% endif %} 
                        {% if block.settings.box_align == 'left' %}left{% elsif block.settings.box_align == 'center' %}center{% elsif block.settings.box_align == 'right' %}right{% endif %}
                        text-{%- if block.settings.text_align == 'left' -%}start{%- elsif block.settings.text_align == 'center' -%}center{%- elsif block.settings.text_align == 'right' -%}end{%- endif -%}" style="transform: translateX({{ block.settings.translateX }});">
                            <h4 class="sub-title-banner">{{ block.settings.sub_title }}</h4>
                            <h2 class="title-banner">{{ block.settings.title }}</h2>
                            {%- if block.settings.line -%}
                                <div class="line  {% if block.settings.box_align == 'left' %}left{% elsif block.settings.box_align == 'center' %}center{% elsif block.settings.box_align == 'right' %}right{% endif %}"></div>
                            {%- endif -%}
                            <p class="description-banner">{{ block.settings.content }}</p>
                            {%- if block.settings.link != blank -%}
                              <a class="link-base link-{%- if block.settings.text_align == 'left' -%}left{%- elsif block.settings.text_align == 'center' -%}center{%- elsif block.settings.text_align == 'right' -%}right{%- endif -%}" href="{{ block.settings.btn_link | default:'#' }}" title="{{ block.settings.link }}">
                                  {{ block.settings.link }}
                                  <i class="leofar leofa-arrow-right"></i>
                              </a>
                            {%- endif -%}
                        </div> 
                </div>
              </div>

              

          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "t:sections.advanced-content.name",
  "tag": "section",
  "class": "spaced-section advanced-content-template",
  "settings": [
    {
      "type": "checkbox",
      "id": "fullwidth",
      "label": "t:sections.advanced-content.settings.fullwidth.label",
      "default": false
    },
    {
      "id": "background-color",
      "type": "color",
      "label": "t:sections.advanced-content.settings.background-color.label"
    },
    {
      "type": "text",
      "id": "margin_desktop",
      "label": "t:sections.advanced-content.settings.margin_desktop.label",
      "info": "t:sections.advanced-content.settings.margin_desktop.info"
    },
    {
      "type": "text",
      "id": "padding_desktop",
      "label": "t:sections.advanced-content.settings.padding_desktop.label",
      "info": "t:sections.advanced-content.settings.padding_desktop.info"
    },
    {
      "type": "text",
      "id": "margin_mobile",
      "label": "t:sections.advanced-content.settings.margin_mobile.label",
      "info": "t:sections.advanced-content.settings.margin_mobile.info"
    },
    {
      "type": "text",
      "id": "padding_mobile",
      "label": "t:sections.advanced-content.settings.padding_mobile.label",
      "info": "t:sections.advanced-content.settings.padding_mobile.info"
    },
    {
