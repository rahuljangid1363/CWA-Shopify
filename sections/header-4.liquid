<!-- header-4.liquid -->
{{ 'header-4.css' | asset_url | stylesheet_tag }}
{% render 'section-style' %}
<style>
  .shopify-section.spaced-header {
    position: relative;
    z-index: 999;
  }
  .header-4 {
    position: relative;
    width: 100%;
    z-index: 999;
    background: #ffffff;
  }
  .header-4-center {
    background: #ffffff;
    padding: 12px 0;
    border-bottom: 1px solid #f0f4f8;
  }
  .header-4-center__inner {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 24px !important;
  }
  .header-4-center .head-logo {
    flex-shrink: 0 !important;
    display: flex !important;
    align-items: center !important;
  }
  .header-4-center .head-logo img {
    height: 42px !important;
    width: auto !important;
    max-height: 44px !important;
    max-width: 220px !important;
    object-fit: contain !important;
    display: block !important;
  }
  .header-4-center__right {
    display: flex !important;
    align-items: center !important;
    gap: 24px !important;
    flex-shrink: 0 !important;
  }
  .header-4 .header-search {
    display: flex !important;
    align-items: center !important;
  }
  .header-4 .header-search .icon-search {
    width: 100% !important;
  }
  .header-4 .form-search,
  .header-4 .header-search .form-search,
  .header-4 #form-search-icon {
    position: static !important;
    visibility: visible !important;
    opacity: 1 !important;
    display: block !important;
    transform: none !important;
    z-index: auto !important;
    margin: 0 !important;
    padding: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
  }
  .header-4 .search-form-cwa {
    margin: 0 !important;
    position: relative !important;
  }
  .header-4 .search-input-wrap {
    display: flex !important;
    align-items: center !important;
    border: 1px solid #d1d5db !important;
    border-radius: 6px !important;
    background-color: #ffffff !important;
    padding: 3px 3px 3px 14px !important;
    width: 450px !important;
    max-width: 100% !important;
    height: 42px !important;
    box-sizing: border-box !important;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .header-4 .search-input-wrap:focus-within {
    border-color: #3075cc !important;
    box-shadow: 0 0 0 3px rgba(48, 117, 204, 0.12) !important;
  }
  .header-4 .search-icon-inline {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    margin-right: 8px !important;
    flex-shrink: 0 !important;
    color: #64748b !important;
  }
  .header-4 .search-icon-inline svg {
    display: block !important;
    width: 15px !important;
    height: 15px !important;
  }
  .header-4 .search-field-cwa {
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
    background: transparent !important;
    flex: 1 1 auto !important;
    width: 100% !important;
    min-width: 0 !important;
    font-size: 13.5px !important;
    color: #1e293b !important;
    padding: 0 8px 0 0 !important;
    height: 100% !important;
    font-family: inherit !important;
  }
  .header-4 .search-field-cwa::placeholder {
    color: #8a99ad !important;
    font-size: 13.5px !important;
    opacity: 1 !important;
  }
  .header-4 .search-submit-btn {
    background-color: #3075cc !important;
    color: #ffffff !important;
    font-size: 13.5px !important;
    font-weight: 600 !important;
    padding: 0 18px !important;
    height: 34px !important;
    line-height: 34px !important;
    border-radius: 4px !important;
    border: none !important;
    cursor: pointer !important;
    white-space: nowrap !important;
    flex-shrink: 0 !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    font-family: inherit !important;
    transition: background-color 0.2s ease;
  }
  .header-4 .search-submit-btn:hover {
    background-color: #2563eb !important;
  }
  .header-4 .header-actions {
    display: flex !important;
    align-items: center !important;
    gap: 20px !important;
  }
  .header-4 .header-actions .header-action-btn,
  .header-4 .header-actions .btn-wishlist,
  .header-4 .header-actions .show_login,
  .header-4 .header-actions .header__icon--cart {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    background: transparent !important;
    border: none !important;
    padding: 4px !important;
    cursor: pointer !important;
    color: #1e293b !important;
    position: relative !important;
    text-decoration: none !important;
  }
  .header-4 .header-actions svg {
    width: 22px !important;
    height: 22px !important;
    stroke: #1e293b !important;
    fill: none !important;
    display: block !important;
    transition: stroke 0.2s ease;
  }
  .header-4 .header-actions a:hover svg,
  .header-4 .header-actions button:hover svg {
    stroke: #3075cc !important;
  }
  .header-4-bottom {
    background-color: #021a36 !important;
    height: 48px !important;
    min-height: 48px !important;
    display: flex !important;
    align-items: center !important;
    position: relative !important;
    border: none !important;
  }
  .header-4-bottom::before {
    display: none !important;
  }
  .header-4-bottom__inner {
    display: flex !important;
    align-items: center !important;
    width: 100% !important;
    height: 48px !important;
  }
  .header-4-bottom .header-vertical-menu {
    position: relative !important;
    height: 100% !important;
    display: flex !important;
    align-items: center !important;
  }
  .header-4-bottom .vertical-bars {
    background: transparent !important;
    border: none !important;
    padding: 0 !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 10px !important;
    cursor: pointer !important;
    height: 100% !important;
  }
  .header-4-bottom .vertical-bars::before {
    display: none !important;
  }
  .header-4-bottom .vertical-bars .left {
    display: inline-flex !important;
    align-items: center !important;
    gap: 10px !important;
    margin: 0 !important;
  }
  .header-4-bottom .vertical-bars .left svg {
    width: 18px !important;
    height: 14px !important;
    display: block !important;
  }
  .header-4-bottom .vertical-bars .left svg path {
    fill: #00B5E2 !important;
  }
  .header-4-bottom .vertical-bars span {
    color: #ffffff !important;
    font-size: 13px !important;
    font-weight: 700 !important;
    letter-spacing: 0.6px !important;
    text-transform: uppercase !important;
    white-space: nowrap !important;
  }
  .header-4-bottom .vertical-bars .icon-down {
    display: inline-flex !important;
    align-items: center !important;
    margin-left: 2px !important;
  }
  .header-4-bottom .vertical-bars .icon-down svg {
    width: 9px !important;
    height: 5px !important;
    display: block !important;
  }
  .header-4-bottom .vertical-bars .icon-down svg path {
    stroke: #00B5E2 !important;
  }
  .header-4-bottom .header-nav-divider {
    width: 1px !important;
    height: 20px !important;
    background-color: rgba(255, 255, 255, 0.35) !important;
    margin: 0 32px 0 24px !important;
    flex-shrink: 0 !important;
  }
  .header-4-bottom .header-megamenu {
    flex: 1 !important;
    height: 100% !important;
    display: flex !important;
    align-items: center !important;
  }
  .header-4-bottom .header-megamenu .nav-mega {
    height: 100% !important;
    display: flex !important;
    align-items: center !important;
    background: transparent !important;
  }
  .header-4-bottom .header-megamenu .site-nav {
    display: flex !important;
    align-items: center !important;
    gap: 36px !important;
    list-style: none !important;
    margin: 0 !important;
    padding: 0 !important;
    height: 100% !important;
  }
  .header-4-bottom .header-megamenu .site-nav__item {
    display: flex !important;
    align-items: center !important;
    height: 100% !important;
    padding: 0 !important;
    border: none !important;
    position: relative !important;
  }
  .header-4-bottom .header-megamenu .site-nav__link {
    color: #ffffff !important;
    font-size: 14px !important;
    font-weight: 500 !important;
    text-decoration: none !important;
    padding: 0 2px !important;
    display: inline-flex !important;
    align-items: center !important;
    height: 100% !important;
    transition: color 0.2s ease !important;
    white-space: nowrap !important;
    letter-spacing: 0.2px !important;
  }
  .header-4-bottom .header-megamenu .site-nav__link:hover {
    color: #38bdf8 !important;
  }
  .header-4-bottom .header-megamenu .site-nav__link.dropdown-toggle::after {
    content: "" !important;
    display: inline-block !important;
    width: 6px !important;
    height: 6px !important;
    border-right: 1.5px solid #ffffff !important;
    border-bottom: 1.5px solid #ffffff !important;
    transform: rotate(45deg) !important;
    margin-left: 7px !important;
    margin-top: -3px !important;
    transition: transform 0.2s ease, border-color 0.2s ease !important;
  }
  .header-4-bottom .header-megamenu .site-nav__item:hover .site-nav__link.dropdown-toggle::after {
    border-color: #38bdf8 !important;
    transform: rotate(225deg) !important;
    margin-top: 3px !important;
  }
  .header-4-bottom .drawer__nav-toggle--open {
    display: none !important;
  }
  #MainContent {
    padding-top: 0;
  }
  @media (max-width: 991px) {
    .header-4-bottom {
      display: none !important;
    }
    .header-4 .header-search .form-search {
      display: none !important;
    }
    .header-4 .header-search .search-media {
      display: block !important;
    }
    .header-4 .icon-menu-mobile {
      display: block !important;
    }
  }
</style>

<header class="header-4 {%- if section.settings.enable_transparent -%}{{ 'color-transparent' | prepend: ' ' }}{%- endif -%}">
  {%- if section.settings.header_announcement_bar -%}
    <div
      class="header-4-announcement-bar"
      style="background-color: {{ section.settings.color_announcement_bar_left }};"
    >
      <div class="{%- if section.settings.fullwidth -%}container-fluid{%- else -%}container{%- endif -%}">
        <div class="row ">
          <div class="announcement-bar-box d-flex align-items-center">
            <div class="header-4-announcement-bar-left">
              <p>{{ section.settings.text_announcement_bar_left }}</p>
            </div>
            <div class="header-4-announcement-bar-right">
              <p>{{ section.settings.text_announcement_bar_right }}</p>
              {%- if section.settings.currencies -%}
                {%- render 'block-currencies' -%}
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>
    </div>
  {%- endif -%}

  <div class="header-4-center">
    <div class="{%- if section.settings.fullwidth -%}container-fluid{%- else -%}container{%- endif -%}">
      <div class="header-4-center__inner">
        <!-- Logo -->
        <div class="head-logo">
          {%- render 'header-logo' -%}
        </div>

        <!-- Search Bar & Action Icons -->
        <div class="header-4-center__right">
          {%- if section.settings.header_seach -%}
            <div class="header-search">
              {%- render 'search-header' -%}
            </div>
          {%- endif -%}

          <div class="header-actions">
            {%- if section.settings.header_wishlist -%}
              {%- render 'wishlist-header' -%}
            {%- endif -%}

            {%- if section.settings.header_card -%}
              {%- render 'header-cart' -%}
            {%- endif -%}

            {%- if section.settings.header_sign -%}
              {%- render 'header-sign' -%}
            {%- endif -%}
          </div>

          {%- render 'icon-megamenu-mobile' -%}
        </div>
      </div>
    </div>
  </div>

  <div class="header-4-bottom">
    <div class="{%- if section.settings.fullwidth -%}container-fluid{%- else -%}container{%- endif -%}">
      <div class="header-4-bottom__inner">
        <!-- Shop by Categories Trigger -->
        <div class="header-vertical-menu">
          <div class="icon-vertical-menu">
            <button type="button" class="vertical-bars" aria-label="Shop by Categories">
              <div class="left">
                {%- render 'icon-vertical' -%}
                <span>SHOP BY CATEGORIES</span>
              </div>
              <div class="icon-down">
                {%- render 'icon-down' -%}
              </div>
            </button>
          </div>
          {%- render 'vertical-menu' -%}
        </div>

        <!-- Vertical Divider Line -->
        <div class="header-nav-divider" aria-hidden="true"></div>

        <!-- Main Navigation Menu -->
        <div class="header-megamenu">
          {%- render 'block-menu' -%}
        </div>
      </div>
    </div>
  </div>

  {%- render 'scrolled-header' -%}
</header>

{% schema %}
{
  "name": "t:sections.header-4.name",
  "class": "spaced-header",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "fullwidth",
      "label": "t:sections.header-4.settings.fullwidth.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "header_announcement_bar",
      "label": "t:sections.header-4.settings.header_announcement_bar.label",
      "default": true
    },
    {
      "type": "color",
      "id": "color_announcement_bar_left",
      "label": "Background  color announcement bar",
      "default": "transparent"
    },
    {
      "type": "color",
      "id": "color_text_announcement_bar",
      "label": "Color text announcement bar",
      "default": "#666666"
    },
    {
      "type": "textarea",
      "id": "text_announcement_bar_left",
      "label": "t:sections.header-4.settings.text_announcement_bar.label",
      "default": "Welcome to our store"
    },
    {
      "type": "textarea",
      "id": "text_announcement_bar_right",
      "label": "Text announcement bar right",
      "default": "Welcome to our store"
    },
    {
      "type": "checkbox",
      "id": "show_signin_top",
      "label": "Show sign in header announcement bar",
      "default": true
    },
    {
      "type": "header",
      "content": "Header center"
    },
    {
      "id": "background_color",
      "type": "color",
      "label": "t:sections.header-4.settings.background-color.label"
    },
    {
      "id": "color_text_headcenter",
      "type": "color",
      "label": "Color text",
      "default": "#000"
    },
    {
      "id": "logo_align",
      "type": "select",
      "options": [
        {
          "value": "left",
          "label": "t:sections.header-4.settings.logo_align.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.header-4.settings.logo_align.options__2.label"
        }
      ],
      "default": "left",
      "label": "t:sections.header-4.settings.logo_align.label"
    },
    {
      "type": "textarea",
      "id": "phone_contact",
      "label": "Phone contact",
      "default": "666 - 880 - 33388"
    },
    {
      "type": "checkbox",
      "id": "header_seach",
      "label": "t:sections.header-4.settings.header_seach.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "header_sign",
      "label": "t:sections.header-4.settings.header_sign.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "header_wishlist",
      "label": "t:sections.header-4.settings.header_wishlist.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "currencies",
      "label": "t:sections.header-4.settings.currencies.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "header_card",
      "label": "t:sections.header-4.settings.header_card.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_transparent",
      "label": "t:sections.header-4.settings.enable_transparent.label"
    },
    {
      "type": "textarea",
      "id": "text_block_menu",
      "label": "Text menu",
      "default": "$15 off your first order. Limited time offer."
    }
  ],
  "blocks": [
    {
      "type": "industry_item",
      "name": "Industries preview item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Industry name"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Preview image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ]
}
{% endschema %}
