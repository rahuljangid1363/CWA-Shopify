<!-- header-4.liquid -->
{{ 'header-4.css' | asset_url | stylesheet_tag }}
{% render 'section-style' %}
<style>
    .header-4-announcement-bar,.header-4-announcement-bar-left ul li a{
      font-style: normal;
      font-weight: 400;
      font-size: 13px;
      line-height: 26px;
      color: {{ section.settings.color_text_announcement_bar }};
    }
    .header-4-announcement-bar-left ul li a:hover{
      color: var(--color-base-link-hover);
    }
    .header-4 .site-header__icon-menu svg path,.header-4 .cart-count-bubble,.header-4 .cart-count-cart-empty,.header-4 .header-sign svg path,.header-4 .header-wishlist svg path, .header-4 .phone-number,.header-4 .header-cart .header__icon svg path,.header-4 .num-wishlisted{
      fill:currentColor;
      color: {{ section.settings.color_text_headcenter }};

    }
    .header-4 .num-wishlisted,.header-4 .cart-count-bubble,.header-4 .cart-count-cart-empty{
      background-color: {{ section.settings.background_color }};
    }
    .shopify-section.spaced-header {
    position: relative;
    z-index: 999;
  }

  .header-4 {
    position: relative;
    width: 100%;
    z-index: 999;
  }
  .header-4-bottom{
    background: white;
  }
  #MainContent{
    padding-top: 0;
  }
</style>
<header class="header-4 {%- if section.settings.enable_transparent -%}{{ 'color-transparent' | prepend: ' ' }}{%- endif -%}">
  {%- if section.settings.header_announcement_bar -%}
    <div
      class="header-4-announcement-bar"
      style="background-color: {{ section.settings.color_announcement_bar_left }};"
    >
      <div class="{%- if section.settings.fullwidth -%}container-fluid{%- else -%}container{%- endif -%}">
        <div class="row ">
          <div class="announcement-bar-box d-flex align-items-center">
            <div class="header-4-announcement-bar-left">
              <p>{{ section.settings.text_announcement_bar_left }}</p>
            </div>
            <div class="header-4-announcement-bar-right">
              <p>{{ section.settings.text_announcement_bar_right }}</p>
              {%- if section.settings.currencies -%}
                {%- render 'block-currencies' -%}
              {%- endif -%}
              {%- if section.settings.show_signin_top -%}
                <div class="signin-top">
                  {% if customer %}
                    <p>
                      <a>Hello {{ customer.first_name }}</a>
                    </p>

                    <p>
                      <a href="/account/logout" title="{{'layout.customer.log_out' | t}}" class="site-header__link">
                        Logout
                      </a>
                    </p>
                    <p><a href="/account" title="My acount">My account</a></p>
                  {%- else -%}
                    Welcome Guess!
                    <p><a href="/account/login" class="site-header__link">Sign in</a></p>
                    or
                    <p><a href="/account/register" title="Register">Register</a></p>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>
    </div>
  {%- endif -%}
  <div class="header-4-center" style="background-color: {{ section.settings.background_color }};">
    <div class="{%- if section.settings.fullwidth -%}container-fluid{%- else -%}container{%- endif -%}">
      <div class="row">
        <div class="header-categories">
          <div class="row">
            <div class="col col-lg-12 col-xl-2 head-logo">
              {%- render 'header-logo' -%}
            </div>

            <div class="col-2 col-lg-7 col-xl-6 header-mobi-mobile header-search">
              {%- if section.settings.header_seach -%}
                {%- render 'search-header' -%}
              {%- endif -%}
              {%- render 'icon-megamenu-mobile' -%}
            </div>

            <div class="col-2 col-lg-5 col-xl-4 header-icon">
              {%- if section.settings.phone_contact != blank -%}
                <div class="phone-number">
                  {{ section.settings.phone_contact }}
                </div>
              {%- endif -%}
              <div class="header-service d-flex">
                {%- if section.settings.header_wishlist -%}
                  {%- render 'wishlist-header' -%}
                {%- endif -%}
                {%- if section.settings.header_sign -%}
                  {%- render 'header-sign' -%}
                {%- endif -%}

                {%- if section.settings.header_card -%}
                  {%- render 'header-cart' -%}
                {%- endif -%}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="header-4-bottom">
    <div class="{%- if section.settings.fullwidth -%}container-fluid{%- else -%}container{%- endif -%}">
      <div class="row">
        <div class="col-lg-3 col-xl-3 header-bottom">
          <div class="header-vertical-menu">
            <div class="icon-vertical-menu">
              <button type="button" class="vertical-bars">
                <div class="left">
                  {%- render 'icon-vertical' -%}
                  <span>Shop by Categories</span>
                </div>
                <div class="icon-down">
                  {%- render 'icon-down' -%}
                </div>
              </button>
            </div>
            {%- render 'vertical-menu' -%}
          </div>
        </div>
        <div class="col-lg-9 col-xl-5 header-megamenu">
          {%- render 'block-menu' -%}
        </div>
        <div class="col-xl-4 text-menu d-flex align-items-center d-none d-xl-flex">
          {{ section.settings.text_block_menu }}
        </div>
      </div>
    </div>
  </div>

  {%- render 'scrolled-header' -%}
</header>

{% schema %}
{
  "name": "t:sections.header-4.name",
  "class": "spaced-header",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "fullwidth",
      "label": "t:sections.header-4.settings.fullwidth.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "header_announcement_bar",
      "label": "t:sections.header-4.settings.header_announcement_bar.label",
      "default": true
    },
    {
      "type": "color",
      "id": "color_announcement_bar_left",
      "label": "Background  color announcement bar",
      "default": "transparent"
    },
    {
      "type": "color",
      "id": "color_text_announcement_bar",
      "label": "Color text announcement bar",
      "default": "#666666"
    },
    {
      "type": "textarea",
      "id": "text_announcement_bar_left",
      "label": "t:sections.header-4.settings.text_announcement_bar.label",
      "default": "Welcome to our store"
    },
    {
      "type": "textarea",
      "id": "text_announcement_bar_right",
      "label": "Text announcement bar right",
      "default": "Welcome to our store"
    },
    {
      "type": "checkbox",
      "id": "show_signin_top",
      "label": "Show sign in header announcement bar",
      "default": true
    },
    {
      "type": "header",
      "content": "Header center"
    },
    {
      "id": "background_color",
      "type": "color",
      "label": "t:sections.header-4.settings.background-color.label"
    },
    {
      "id": "color_text_headcenter",
      "type": "color",
      "label": "Color text",
      "default": "#000"
    },
    {
      "id": "logo_align",
      "type": "select",
      "options": [
        {
          "value": "left",
          "label": "t:sections.header-4.settings.logo_align.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.header-4.settings.logo_align.options__2.label"
        }
      ],
      "default": "left",
      "label": "t:sections.header-4.settings.logo_align.label"
    },
    {
      "type": "textarea",
      "id": "phone_contact",
      "label": "Phone contact",
      "default": "666 - 880 - 33388"
    },
    {
      "type": "checkbox",
      "id": "header_seach",
      "label": "t:sections.header-4.settings.header_seach.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "header_sign",
      "label": "t:sections.header-4.settings.header_sign.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "header_wishlist",
      "label": "t:sections.header-4.settings.header_wishlist.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "currencies",
      "label": "t:sections.header-4.settings.currencies.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "header_card",
      "label": "t:sections.header-4.settings.header_card.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_transparent",
      "label": "t:sections.header-4.settings.enable_transparent.label"
    },
    {
      "type": "textarea",
      "id": "text_block_menu",
      "label": "Text menu",
      "default": "$15 off your first order. Limited time offer."
    }
  ],
  "blocks": [
    {
      "type": "industry_item",
      "name": "Industries preview item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Industry name"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Preview image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ]
}
{% endschema %}
