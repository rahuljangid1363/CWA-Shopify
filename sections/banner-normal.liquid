<!-- banner-normal.liquid -->
{% render 'section-style' %}
{{ 'banner-normal.css' | asset_url | stylesheet_tag }}
{%- style -%}
.banner-normal .sub-title{
  color:{{ section.settings.color_sub_title }};
}
.banner-normal .title-banner{
    color:{{ section.settings.color_banner }};
}
.banner-normal .description-banner{
  color:{{ section.settings.color_description }};
}
.banner-normal .line{
    border:1px solid {{ section.settings.color_banner }};
}

{%- endstyle %}
<div class="banner-normal" style=" background-color:{{ section.settings.bg_color }};">
    <div class="{%- if section.settings.fullwidth -%}container-fluid{%- else -%}larger-container{%- endif -%}">
      <div class="banner-normal-box">
        <div class="image-banner-normal">
          <img src="{{ section.settings.bg_banner | img_url:'master'}}" alt="">
        </div>
        <div class="text-banner">
          <div class="text-box d-flex flex-column justify-content-{% if section.settings.item_align == 'top' %}start{% elsif section.settings.item_align == 'center' %}center{% elsif section.settings.item_align == 'bottom' %}end{% endif %} 
          {% if section.settings.box_align == 'left' %}left{% elsif section.settings.box_align == 'center' %}center{% elsif section.settings.box_align == 'right' %}right{% endif %}
          text-{%- if section.settings.text_align == 'left' -%}start{%- elsif section.settings.text_align == 'center' -%}center{%- elsif section.settings.text_align == 'right' -%}end{%- endif -%}" style="transform: translateX({{ section.settings.translateX }});">
          {%- style -%}
           .banner-normal .link-base{
              background-color:{{ section.settings.bg_button }};
              color:{{ section.settings.color_button }};
              border: none;
            }
           .banner-normal .link-base:hover{
              background-color:{{ section.settings.bg_button_hover }};
              color:{{ section.settings.color_button_hover }};
            }
          {%- endstyle -%}    
              <h4 class="sub-title">{{ section.settings.sub_title }}</h4>
              <h2 class="section-header">{{ section.settings.title }}</h2>
              {%- if section.settings.line -%}
                  <div class="line  {% if section.settings.box_align == 'left' %}left{% elsif section.settings.box_align == 'center' %}center{% elsif section.settings.box_align == 'right' %}right{% endif %}"></div>
              {%- endif -%}
              <p class="description-banner">{{ section.settings.content }}</p>
              {%- if section.settings.countdown != blank -%}
              
              <div class="banner-countdown js-countdown js-countdown--countdown--1 link-{%- if section.settings.text_align == 'left' -%}left{%- elsif section.settings.text_align == 'center' -%}center{%- elsif section.settings.text_align == 'right' -%}right{%- endif -%} " data-time="{{ section.settings.countdown }} "></div>
              
              {%- endif -%}
              {%- if section.settings.link != blank -%}
                <a class="link-base link-{%- if section.settings.text_align == 'left' -%}left{%- elsif section.settings.text_align == 'center' -%}center{%- elsif section.settings.text_align == 'right' -%}right{%- endif -%}" href="{{ section.settings.btn_link | default:'#' }}" title="{{ section.settings.link }}">
                    {{ section.settings.link }}
                    <i class="leofar leofa-arrow-right"></i>
                </a>
              {%- endif -%}
    </div> 
        </div>
     
      </div>
    </div>
</div>
{% schema %}
{
    "name": "Banner normal",
    "tag": "section",
    "class": "banner-normal-section",
    "settings": [
    {
        "type": "checkbox",
        "id": "fullwidth",
        "label": "t:sections.slide-show.settings.fullwidth.label",
        "default": true
      },
      {
        "type": "image_picker",
        "id": "bg_banner",
        "label": "Background image"
      },
      {
        "type": "color",
        "id": "bg_color",
        "label": "Background color",
        "default":"transparent"
      },
      {
        "type": "text",
        "id": "margin_desktop",
        "label": "t:sections.slide-show.settings.margin_desktop.label",
        "info": "t:sections.slide-show.settings.margin_desktop.info"
      },
      {
        "type": "text",
        "id": "padding_desktop",
        "label": "t:sections.slide-show.settings.padding_desktop.label",
        "info": "t:sections.slide-show.settings.padding_desktop.info"
      },
      {
        "type": "text",
        "id": "margin_mobile",
        "label": "t:sections.slide-show.settings.margin_mobile.label",
        "info": "t:sections.slide-show.settings.margin_mobile.info"
      },
      {
        "type": "text",
        "id": "padding_mobile",
        "label": "t:sections.slide-show.settings.padding_mobile.label",
        "info": "t:sections.slide-show.settings.padding_mobile.info"
      },
      
       {
          "type": "text",
          "id": "sub_title",
          "label": "t:sections.slide-show.blocks.slide.settings.sub_title.label",
          "default": "Sub-title slider-show"
        },
        {
          "type": "color",
          "id": "color_sub_title",
          "label": "Color sub title",
          "default": "#59805B"
        },
        {
          "id": "title",
          "type": "text",
          "label": "t:sections.slide-show.blocks.slide.settings.title.label",
          "default": "Title slider-show"
        },
        {
          "type": "color",
          "id": "color_banner",
          "label": "Color text",
          "default": "#fff"
        },
        {
            "id": "line",
            "type": "checkbox",
            "label": "Show a line",
            "default": true
          },
          {
            "id": "countdown",
            "type": "text",
            "label": "Countdown",
            "default": "2025-12-30T00:00:00"
          },
        {
          "id": "content",
          "type": "text",
          "label": "t:sections.slide-show.blocks.slide.settings.content.label",
          "default": "We are at the end of the ‘50s: an interesting series of armchairs and"
        },
        {
          "type": "color",
          "id": "color_description",
          "label": "Color text content",
          "default": "#666666"
        },
        {
          "id": "link",
          "type": "text",
          "label": "t:sections.slide-show.blocks.slide.settings.link.label",
          "default": "Show More"
        },
        {
          "id": "btn_link",
          "type": "url",
          "label": "t:sections.slide-show.blocks.slide.settings.btn_link.label"
        },
        {
          "type": "select",
          "id": "box_align",
          "label": "Box align",
          "default": "center",
          "options": [
            {
              "value": "left",
              "label": "left"
            },
            {
              "value": "center",
              "label": "center"
            },
            {
              "value": "right",
              "label": "right"
            }
          ]
         },
         {
          "type": "text",
          "id": "translateX",
          "label": "Translate X box",
          "info":"if you want to adjust the position of box-content,you can use it. Example:10%,-10%,20px,-230px..."
        },
        {
          "type": "select",
          "id": "text_align",
          "label": "t:sections.slide-show.blocks.slide.settings.text_align.label",
          "default": "center",
          "options": [
            {
              "value": "left",
              "label": "t:sections.slide-show.blocks.slide.settings.text_align.options__1.label"
            },
            {
              "value": "center",
              "label": "t:sections.slide-show.blocks.slide.settings.text_align.options__2.label"
            },
            {
              "value": "right",
              "label": "t:sections.slide-show.blocks.slide.settings.text_align.options__3.label"
            }
          ]
         },
         {
          "type": "select",
          "id": "item_align",
          "label": "t:sections.slide-show.blocks.slide.settings.item_align.label",
          "default": "center",
          "options": [
            {
              "value": "top",
              "label": "t:sections.slide-show.blocks.slide.settings.item_align.options__1.label"
            },
            {
              "value": "center",
              "label": "t:sections.slide-show.blocks.slide.settings.item_align.options__2.label"
            },
            {
              "value": "bottom",
              "label": "t:sections.slide-show.blocks.slide.settings.item_align.options__3.label"
            }
          ]
         },
         {
            "type": "color",
            "id": "bg_button",
            "label": "Background button",
            "default": "#94BE90"
          },
          {
             "type": "color",
             "id": "color_button",
             "label": "Color button",
             "default": "#fff"
           },
           {
              "type": "color",
              "id": "border-color",
              "label": "Border button",
              "default": "transparent"
            },
            {
               "type": "color",
               "id": "bg_button_hover",
               "label": "Background button hover",
               "default": "#000"
             },
             {
                "type": "color",
                "id": "color_button_hover",
                "label": "Color button hover",
                "default": "#fff"
              },
              {
                 "type": "color",
                 "id": "border_color_hover",
                 "label": "Border button hover",
                 "default": "transparent"
               }
    ],
    "presets":[
        {
           "name": "Banner normal"
        }
    ]
}
{% endschema %}