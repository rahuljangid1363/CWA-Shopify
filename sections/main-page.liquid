<link rel="stylesheet" href="{{ 'section-main-page.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-rte.css' | asset_url }}" media="print" onload="this.media='all'">

<noscript>{{ 'section-main-page.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-rte.css' | asset_url | stylesheet_tag }}</noscript>

{%- assign page_handle_down = page.handle | downcase -%}
{%- assign page_url_down = request.path | downcase -%}
{%- if page_handle_down == 'wishlist' or page_handle_down == 'wish-list' or page_handle_down == 'my-wishlist' or page_handle_down contains 'wishlist' or page_url_down contains 'wishlist' or page.handle == settings.page_wishlist or template.suffix == 'wishlist' or template == 'page.wishlist' -%}
  {%- render 'wishlist-page-content' -%}
{%- else -%}
  <div class="page-width page-width--narrow">
    <div class="rte">
      {{ page.content }}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.main-page.name",
  "tag": "section",
  "class": "spaced-section"
}
{% endschema %}
