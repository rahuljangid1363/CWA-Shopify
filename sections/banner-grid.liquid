<!-- banner-grid.liquid -->

{{ 'banner-grid.css' | asset_url | stylesheet_tag }}
{% render 'section-style' %}

{%- assign flow_image = nil -%}
{%- assign flow_title = 'Flow Measurement' -%}
{%- assign flow_link = '/collections/flow-measurement' -%}

{%- assign liquid_image = nil -%}
{%- assign liquid_title = 'Liquid Analysis' -%}
{%- assign liquid_link = '/collections/liquid-analysis' -%}

{%- assign level_image = nil -%}
{%- assign level_title = 'Level Measurement' -%}
{%- assign level_link = '/collections/level-measurement' -%}

{%- assign pressure_image = nil -%}
{%- assign pressure_title = 'Pressure Measurement' -%}
{%- assign pressure_link = '/collections/pressure-measurement' -%}

{%- for block in section.blocks -%}
  {%- if block.type == 'image2row' -%}
    {%- if block.settings.image != blank -%}{%- assign liquid_image = block.settings.image -%}{%- endif -%}
    {%- if block.settings.subheader_image != blank -%}{%- assign liquid_title = block.settings.subheader_image -%}{%- endif -%}
    {%- if block.settings.btn_link != blank -%}{%- assign liquid_link = block.settings.btn_link -%}{%- endif -%}

    {%- if block.settings.image2 != blank -%}{%- assign level_image = block.settings.image2 -%}{%- endif -%}
    {%- if block.settings.subheader_image2 != blank -%}{%- assign level_title = block.settings.subheader_image2 -%}{%- endif -%}
    {%- if block.settings.btn_link2 != blank -%}{%- assign level_link = block.settings.btn_link2 -%}{%- endif -%}
  {%- else -%}
    {%- assign block_title_lower = block.settings.subheader_image | downcase -%}
    {%- if block_title_lower contains 'flow' or forloop.first -%}
      {%- if block.settings.image != blank -%}{%- assign flow_image = block.settings.image -%}{%- endif -%}
      {%- if block.settings.subheader_image != blank -%}{%- assign flow_title = block.settings.subheader_image -%}{%- endif -%}
      {%- if block.settings.btn_link != blank -%}{%- assign flow_link = block.settings.btn_link -%}{%- endif -%}
    {%- elsif block_title_lower contains 'pressure' -%}
      {%- if block.settings.image != blank -%}{%- assign pressure_image = block.settings.image -%}{%- endif -%}
      {%- if block.settings.subheader_image != blank -%}{%- assign pressure_title = block.settings.subheader_image -%}{%- endif -%}
      {%- if block.settings.btn_link != blank -%}{%- assign pressure_link = block.settings.btn_link -%}{%- endif -%}
    {%- elsif block_title_lower contains 'liquid' -%}
      {%- if block.settings.image != blank -%}{%- assign liquid_image = block.settings.image -%}{%- endif -%}
      {%- if block.settings.subheader_image != blank -%}{%- assign liquid_title = block.settings.subheader_image -%}{%- endif -%}
      {%- if block.settings.btn_link != blank -%}{%- assign liquid_link = block.settings.btn_link -%}{%- endif -%}
    {%- elsif block_title_lower contains 'level' -%}
      {%- if block.settings.image != blank -%}{%- assign level_image = block.settings.image -%}{%- endif -%}
      {%- if block.settings.subheader_image != blank -%}{%- assign level_title = block.settings.subheader_image -%}{%- endif -%}
      {%- if block.settings.btn_link != blank -%}{%- assign level_link = block.settings.btn_link -%}{%- endif -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}

<div class="banner-grid cwa-category-section">
  <div class="{%- if section.settings.fullwidth -%}container-fluid{%- else -%}container{%- endif -%}">
    <!-- Header -->
    <div class="banner-grid-header">
      <h2 class="banner-grid-title">{{ section.settings.heading | default: 'FIND THE RIGHT INSTRUMENTATION' }}</h2>
      <p class="banner-grid-subtitle">{{ section.settings.text_decoration | default: section.settings.subheading | default: 'Explore our range of precision instruments for every applications' }}</p>
    </div>

    <!-- 4 Categories Grid -->
    <div class="cwa-instrument-grid">
      <!-- Left Tall Column: Flow Measurement -->
      <div class="cwa-grid-col-left">
        <a href="{{ flow_link }}" class="cwa-card cwa-card-flow">
          <div class="cwa-card-header">
            <h3 class="cwa-card-title">{{ flow_title | replace: ' ', '<br>' | upcase }}</h3>
            <span class="cwa-card-arrow">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </span>
          </div>
          <div class="cwa-card-image cwa-image-flow">
            {%- if flow_image != blank -%}
              <img src="{{ flow_image | img_url: 'master' }}" alt="{{ flow_title | escape }}" loading="lazy">
            {%- else -%}
              <img src="{{ 'Flow_Measurement.png' | file_img_url: 'master' }}" alt="{{ flow_title | escape }}" loading="lazy">
            {%- endif -%}
          </div>
        </a>
      </div>

      <!-- Right Column -->
      <div class="cwa-grid-col-right">
        <!-- Top Row: Liquid Analysis & Level Measurement -->
        <div class="cwa-grid-row-top">
          <!-- Liquid Analysis -->
          <a href="{{ liquid_link }}" class="cwa-card cwa-card-liquid">
            <div class="cwa-card-header cwa-header-right">
              <h3 class="cwa-card-title">{{ liquid_title | replace: ' ', '<br>' | upcase }}</h3>
              <span class="cwa-card-arrow">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
              </span>
            </div>
            <div class="cwa-card-image cwa-image-liquid">
              {%- if liquid_image != blank -%}
                <img src="{{ liquid_image | img_url: 'master' }}" alt="{{ liquid_title | escape }}" loading="lazy">
              {%- else -%}
                <img src="{{ 'Liquid_Analysis.png' | file_img_url: 'master' }}" alt="{{ liquid_title | escape }}" loading="lazy">
              {%- endif -%}
            </div>
          </a>

          <!-- Level Measurement -->
          <a href="{{ level_link }}" class="cwa-card cwa-card-level">
            <div class="cwa-card-header">
              <h3 class="cwa-card-title">{{ level_title | replace: ' ', '<br>' | upcase }}</h3>
              <span class="cwa-card-arrow">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
              </span>
            </div>
            <div class="cwa-card-image cwa-image-level">
              {%- if level_image != blank -%}
                <img src="{{ level_image | img_url: 'master' }}" alt="{{ level_title | escape }}" loading="lazy">
              {%- else -%}
                <img src="{{ 'Level_Measurement.png' | file_img_url: 'master' }}" alt="{{ level_title | escape }}" loading="lazy">
              {%- endif -%}
            </div>
          </a>
        </div>

        <!-- Bottom Row: Pressure Measurement -->
        <div class="cwa-grid-row-bottom">
          <a href="{{ pressure_link }}" class="cwa-card cwa-card-pressure">
            <div class="cwa-card-header">
              <h3 class="cwa-card-title">{{ pressure_title | replace: ' ', '<br>' | upcase }}</h3>
              <span class="cwa-card-arrow">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
              </span>
            </div>
            <div class="cwa-card-image cwa-image-pressure">
              {%- if pressure_image != blank -%}
                <img src="{{ pressure_image | img_url: 'master' }}" alt="{{ pressure_title | escape }}" loading="lazy">
              {%- else -%}
                <img src="{{ 'Pressure_Measurement.png' | file_img_url: 'master' }}" alt="{{ pressure_title | escape }}" loading="lazy">
              {%- endif -%}
            </div>
          </a>
        </div>
      </div>
    </div>

    <!-- Bottom CTA Button -->
    <div class="banner-grid-footer">
      <a href="{{ section.settings.btn_link | default: '/collections' }}" class="cwa-view-all-btn">
        {{ section.settings.btn_text | default: 'View All Categories' }}
      </a>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.banner-grid.name",
  "tag": "section",
  "class": "spaced-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "fullwidth",
      "label": "Full width",
      "default": false
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FIND THE RIGHT INSTRUMENTATION"
    },
    {
      "type": "text",
      "id": "text_decoration",
      "label": "Subtitle / Description",
      "default": "Explore our range of precision instruments for every applications"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Bottom button text",
      "default": "View All Categories"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Bottom button link"
    },
    {
      "type": "text",
      "id": "margin_desktop",
      "label": "Margin Desktop",
      "default": "60px 0px 0px 0px"
    },
    {
      "type": "text",
      "id": "padding_desktop",
      "label": "Padding Desktop"
    },
    {
      "type": "text",
      "id": "margin_mobile",
      "label": "Margin Mobile",
      "default": "30px 0px 0px 0px"
    },
    {
      "type": "text",
      "id": "padding_mobile",
      "label": "Padding Mobile"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "subheader_image",
          "label": "Title"
        },
        {
          "type": "url",
          "id": "btn_link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "image2row",
      "name": "2 Image Row",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image 1"
        },
        {
          "type": "text",
          "id": "subheader_image",
          "label": "Title 1"
        },
        {
          "type": "url",
          "id": "btn_link",
          "label": "Link 1"
        },
        {
          "type": "image_picker",
          "id": "image2",
          "label": "Image 2"
        },
        {
          "type": "text",
          "id": "subheader_image2",
          "label": "Title 2"
        },
        {
          "type": "url",
          "id": "btn_link2",
          "label": "Link 2"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.banner-grid.name"
    }
  ]
}
{% endschema %}