<style>
    .contact-content{
        margin-top: 40px;
        padding: 0 15px;
    }

    .left-content-contact{
        padding-right: 30px;
    }
    .gmap-iframe {
      margin-bottom: 30px
    }
  
    .gmap-iframe .gmap_canvas,
    .gmap-iframe .mapouter,
    .gmap-iframe iframe {
      width: 100%!important
    }
  
    @media (max-width:767px) {
      .gmap-iframe .gmap_canvas,
      .gmap-iframe .mapouter,
      .gmap-iframe iframe {
        height: 350px!important
      }
      .contact_our{
        margin-top: 20px;
    }
    }
  
    .contact-page__info li {
      padding: 2px 0;
      line-height: 33px
    }

  
    .contact-page__info .icon,
    .contact-page__info [class^=icon-] {
      width: auto;
      margin-right: 10px;
      height: 18px;
    }
  
    .rtl .contact-page__info .icon {
        vertical-align: text-bottom
    }
  
    .contact-page__info i {
      margin-right: 8px;
    }
  
    .more-info img{
      max-width: 90px;
    }

    .contact-from-wrap .col-md-8, .contact-from-wrap .col-md-4{
      padding: 0 15px;
    }

    .our-staff{
      display: flex;
      align-items: flex-start;
      margin-bottom: 15px;
    }

    .our-staff img{
      margin-right: 15px;
    }

    .our-staff-header{
      font-size: 20px;
    }

    .title-contact_our{
      font-size: 32px;
      font-weight: 500;
    }
  
    @media (min-width:992px){
      .contact-from-wrap{
        padding: 40px;
        border: 1px solid #ccc;
        border-radius: 5px;
        margin-bottom: 60px;
      }
    }
  </style>
  {{ 'section-contact-form.css' | asset_url | stylesheet_tag }}
  <!-- contact-content.liquid -->
  <div class="container">
    <div class="cwa-contact">
      <div class="cwa-contact__info">
        {%- if section.settings.info_title != blank -%}
          <h2 class="cwa-contact__title">{{ section.settings.info_title }}</h2>
        {%- endif -%}
        {%- if section.settings.info_text != blank -%}
          <p class="cwa-contact__text">{{ section.settings.info_text }}</p>
        {%- endif -%}
        <div class="cwa-contact__qrs">
          {%- if section.settings.qr_email_image != blank or section.settings.info_email != blank -%}
            <div class="cwa-contact__qr">
              {%- if section.settings.qr_email_image != blank -%}
                <img src="{{ section.settings.qr_email_image | img_url: '200x' }}" alt="Email QR code" width="100" height="100" loading="lazy">
              {%- endif -%}
              <span class="cwa-contact__qr-label">Email</span>
              {%- if section.settings.info_email != blank -%}
                <a class="cwa-contact__qr-value" href="mailto:{{ section.settings.info_email }}">{{ section.settings.info_email }}</a>
              {%- endif -%}
            </div>
          {%- endif -%}
          {%- if section.settings.qr_whatsapp_image != blank or section.settings.info_whatsapp != blank -%}
            <div class="cwa-contact__qr">
              {%- if section.settings.qr_whatsapp_image != blank -%}
                <img src="{{ section.settings.qr_whatsapp_image | img_url: '200x' }}" alt="WhatsApp QR code" width="100" height="100" loading="lazy">
              {%- endif -%}
              <span class="cwa-contact__qr-label">WhatsApp</span>
              {%- if section.settings.info_whatsapp != blank -%}
                <a class="cwa-contact__qr-value" href="https://wa.me/{{ section.settings.info_whatsapp | remove: '+' | remove: ' ' | remove: '-' }}" target="_blank" rel="noopener">{{ section.settings.info_whatsapp }}</a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>

      <div class="cwa-contact__card">
        {%- form 'contact', id: 'ContactForm' -%}
          {%- if form.posted_successfully? -%}
          <div class="form-status form-status-list form__message" tabindex="-1" autofocus>{% render 'icon-success' %} {{ 'templates.contact.form.post_success' | t }}</div>
          {%- elsif form.errors -%}
          <div class="form__message">
              <h2 class="form-status caption-large" role="alert" tabindex="-1" autofocus>{% render 'icon-error' %} {{ 'templates.contact.form.error_heading' | t }}</h2>
          </div>
          <ul class="form-status-list caption-large" role="list">
              <li>
              <a href="#ContactForm-email" class="link">
                  {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
              </a>
              </li>
          </ul>
          {%- endif -%}

          <div class="cwa-field">
            <label for="ContactForm-name">Name <span class="cwa-field__req" aria-hidden="true">*</span></label>
            <input autocomplete="name" type="text" id="ContactForm-name" name="contact[{{ 'templates.contact.form.name' | t }}]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
          </div>

          <div class="cwa-field">
            <label for="ContactForm-email">Email</label>
            <input
              autocomplete="email"
              type="email"
              id="ContactForm-email"
              name="contact[email]"
              spellcheck="false"
              autocapitalize="off"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              aria-required="true"
              {% if form.errors contains 'email' %}
                aria-invalid="true"
                aria-describedby="ContactForm-email-error"
              {% endif %}
            >
            {%- if form.errors contains 'email' -%}
              <small class="contact__field-error" id="ContactForm-email-error">
                <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
                <span class="form__message">{% render 'icon-error' %}{{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}</span>
              </small>
            {%- endif -%}
          </div>

          <div class="cwa-field">
            <label for="ContactForm-phone">Telephone <span class="cwa-field__req" aria-hidden="true">*</span></label>
            <input type="tel" id="ContactForm-phone" autocomplete="tel" name="contact[{{ 'templates.contact.form.phone' | t }}]" pattern="[0-9\-]*" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}">
          </div>

          <div class="cwa-field cwa-field--textarea">
            <label for="ContactForm-body">Inquiry Content <span class="cwa-field__req" aria-hidden="true">*</span></label>
            <textarea rows="4" id="ContactForm-body" name="contact[{{ 'templates.contact.form.comment' | t }}]">{{- form.body -}}</textarea>
          </div>

          <div class="cwa-contact__submit">
            <button type="submit" class="cwa-contact__btn">Submit</button>
          </div>
        {%- endform -%}
      </div>
    </div>
  </div>
  {% schema %}
  {
    "name": "t:sections.contact-us.name",
    "class": "page-section",
    "tag": "section",
    "settings": [
      {
        "type": "header",
        "content": "t:sections.contact-us.settings.header.content"
      },
      {
        "type": "checkbox",
        "id": "gmap",
        "label": "t:sections.contact-us.settings.gmap.label",
        "default": true
      },
      {
        "type": "textarea",
        "id": "gmap_iframe",
        "label": "t:sections.contact-us.settings.gmap_iframe.label",
        "info": "💡 [Get iframe code here](https:\/\/www.embedgooglemap.net\/)"
      },
      {
        "type": "header",
        "content": "t:sections.contact-us.settings.header_2.content"
      },
      {
        "type": "text",
        "id": "contact_title",
        "label": "t:sections.contact-us.settings.contact_title.label",
        "default": "Visit one of our agency locations or contact us today."
      },
      {
        "type": "textarea",
        "id": "contact_des",
        "label": "t:sections.contact-us.settings.contact_des.label",
        "default": "Have a question? Give us a call or fill out the contact form. We’d love to hear from you"
      },
      {
        "type": "text",
        "id": "contact_addess",
        "label": "t:sections.contact-us.settings.contact_addess.label",
        "default": "123 Sky Tower, West 21th Street, Suite 721, NY"
      },
      {
        "type": "text",
        "id": "contact_phone",
        "label": "t:sections.contact-us.settings.contact_phone.label",
        "default": "+844 123 456 789"
      },
      {
        "type": "text",
        "id": "contact_mail",
        "label": "t:sections.contact-us.settings.contact_mail.label",
        "default": "sale@yourcompany.com"
      },
      {
        "type": "text",
        "id": "contact_web",
        "label": "t:sections.contact-us.settings.contact_web.label",
        "default": "www.example.com"
      },
      {
        "type": "header",
        "content": "t:sections.contact-us.settings.header_3.content"
      },
      {
        "type": "text",
        "id": "moreinfo_title",
        "label": "t:sections.contact-us.settings.moreinfo_title.label",
        "default": "Our staff"
      },
      {
        "type": "header",
        "content": "Contact form section"
      },
      {
        "type": "text",
        "id": "info_title",
        "label": "Heading",
        "default": "Need more information?"
      },
      {
        "type": "textarea",
        "id": "info_text",
        "label": "Text",
        "default": "Contact us for more details about our solutions and services"
      },
      {
        "type": "image_picker",
        "id": "qr_email_image",
        "label": "Email QR code"
      },
      {
        "type": "text",
        "id": "info_email",
        "label": "Email address",
        "default": "info@cwa.com"
      },
      {
        "type": "image_picker",
        "id": "qr_whatsapp_image",
        "label": "WhatsApp QR code"
      },
      {
        "type": "text",
        "id": "info_whatsapp",
        "label": "WhatsApp number",
        "default": "+8615868103947"
      }
    ],
    "blocks": [
    {
      "type": "information",
      "name": "t:sections.contact-us.blocks.information.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "t:sections.contact-us.blocks.information.settings.icon.label"
        },
        {
          "id": "title",
          "type": "text",
          "label": "t:sections.contact-us.blocks.information.settings.title.label",
          "default": "Service heading"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "t:sections.contact-us.blocks.information.settings.description.label",
          "default": "Cras sit amet nibh libero, in gravida nulla. Nulla vel metus scelerisque ante sollicitudin. Cras purus odio, vestibulum in vulputate at, tempus viverra turpis."
        }
      ]
    }
  ]
  }
  {% endschema %}