<style>
  .cwa-cbanner__hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 370px;
    padding: 60px 0;
    overflow: hidden;
    background: #0b1a2e;
    color: #fff;
  }

  .cwa-cbanner__hero img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cwa-cbanner__hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(0, 0, 0, 0.6) 0%, rgba(0, 0, 0, 0.25) 55%, rgba(0, 0, 0, 0) 100%);
  }

  .cwa-cbanner__content {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .cwa-cbanner__title {
    max-width: 620px;
    margin: 0 0 24px;
    font-size: 40px;
    font-weight: 700;
    line-height: 1.2;
    color: #fff;
  }

  .cwa-cbanner__text {
    max-width: 560px;
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: #fff;
  }

  .cwa-cbanner__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    padding: 60px 0 60px;
  }

  .cwa-cbanner__card {
    padding: 38px 16px 30px;
    background: #fff;
    border: 1px solid #e5e8eb;
    border-radius: 4px;
  }

  .cwa-cbanner__card-title {
    margin: 0 0 12px;
    font-size: 20px;
    font-weight: 400;
    color: #111;
  }

  .cwa-cbanner__card-text {
    margin: 0;
    font-size: 16px;
    line-height: 1.7;
    color: #333;
  }

  @media (max-width: 991px) {
    .cwa-cbanner__cards {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 575px) {
    .cwa-cbanner__hero {
      min-height: 300px;
      padding: 40px 0;
    }

    .cwa-cbanner__title {
      font-size: 30px;
    }
  }
</style>

<div class="cwa-cbanner">
  <div class="cwa-cbanner__hero">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | img_url: '2000x' }}" alt="{{ section.settings.image.alt | escape }}" loading="eager">
    {%- endif -%}
    <div class="cwa-cbanner__content container">
      {%- if section.settings.heading != blank -%}
        <h1 class="cwa-cbanner__title">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p class="cwa-cbanner__text">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="container">
      <div class="cwa-cbanner__cards">
        {%- for block in section.blocks -%}
          <div class="cwa-cbanner__card" {{ block.shopify_attributes }}>
            <h3 class="cwa-cbanner__card-title">{{ block.settings.title }}</h3>
            <p class="cwa-cbanner__card-text">{{ block.settings.text }}</p>
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Contact banner",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Need instrumentation? Let’s get it moving."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Tell us what you need and our team will help you find the right product or solution for your application."
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Request a Quote"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Send your process details, quantities and delivery location."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact banner"
    }
  ]
}
{% endschema %}
