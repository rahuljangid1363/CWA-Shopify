<!-- newsletter.liquid -->
<style>
.newsletter{
  position: relative;
  padding: 56px 0;
  background-color: {{ section.settings.bg_color | default: '#0b0f14' }} !important;
  overflow: hidden;
}
.newsletter.has-bg-image::before{
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, rgba(0,0,0,.92) 0%, rgba(0,0,0,.75) 38%, rgba(0,0,0,.15) 75%, rgba(0,0,0,0) 100%);
  z-index: 1;
}
.newsletter .container,
.newsletter .container-fluid{
  position: relative;
  z-index: 2;
}
.newsletter h4,.newsletter p{
  color:{{ section.settings.color_text }};
}
.newsletter p{
  font-style: normal;
  font-weight: 400;
  font-size: 15px;
  line-height: 1.6;
  opacity: .85;
}
.newsletter .sub-title{
  margin-bottom: 12px;
  font-style: normal;
  font-weight: 400;
  font-size: 36px;
  line-height: 44px;
}

.newsletter h4{
  font-family: "Plus Jakarta Sans", sans-serif;
  font-style: normal;
  font-weight: 800;
  font-size: 30px;
  margin-bottom: 14px;
  line-height: 1.25;
  text-transform: uppercase;
}
.newsletter .field__label{
  color: #888888;
  font-size: 1.3rem;
  top: 1.3rem;
}
.newsletter .section-block__subtext{
  margin-bottom: 22px;
  max-width: 620px;
}
.newsletter .field{
  position: relative;
}
.newsletter .field--with-icon .field__input{
  padding-left: 42px;
  padding-right: 16px;
}
.newsletter .field--with-icon .field__label{
  left: 42px;
}
.newsletter .field__icon{
  position: absolute;
  left: 15px;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  color: #9a9a9a;
  pointer-events: none;
}
.newsletter .field__icon svg{
  width: 15px;
  height: 12px;
  display: block;
}
.newsletter .field__icon svg path{
  fill: currentColor;
}
.newsletter .field__input{
  margin-bottom: 0;
  height: 48px;
  padding-top: 0;
  padding-bottom: 0;
  border-radius: 6px;
  background-color: #fff;
  box-shadow: none;
  border: none;
  box-sizing: border-box;
  line-height: 48px;
}
.newsletter .footer-block__newsletter form{
  display: flex;
  max-width: 760px;
  width: 100%;
}

.newsletter .button{
  font-size: 14px;
  font-weight: 600;
  box-shadow: none;
  padding: 0 24px;
  height: 48px;
  min-height: 48px;
  min-width: unset;
  border-radius: 6px;
  background-color: {{ section.settings.bg_color_button }};
  color: {{ section.settings.color_button }};
  background: linear-gradient(110deg, #3C88E9 0%, #2564B4 100%) !important;
  white-space: nowrap;
  flex-shrink: 0;
}
.newsletter .button i{
  display: none;
}
.newsletter .button:hover{
  box-shadow: none;
  opacity: .92;
}
.newsletter .grid__item{
  max-width: 100%;
  padding: 0;
}
.newsletter .section-block{
  max-width: 780px;
}
@media (min-width:567px) {
  .newsletter .newsletter-form__field-wrapper{
    flex: 1;
    min-width: 360px;
    margin-right: 12px;
  }
}
@media (max-width:567px) {
  .newsletter .footer-block__newsletter form{
    flex-wrap: wrap;
    justify-content: center;
  }
  .newsletter-form__field-wrapper{
    width: 100%;
  }
 .newsletter .button{
    margin-top: 12px;
    width: 100%;
  }
}
</style>
{%- liquid
  if section.settings.bg_image != blank
    assign bg_img_url = section.settings.bg_image | img_url: 'master'
  else
    assign bg_img_url = 'news_letter_bg.webp' | file_img_url: 'master'
  endif

  assign n_heading = section.settings.heading
  if n_heading == blank or n_heading == 'Subscribe to our newsletter'
    assign n_heading = "Know what’s in stock. Keep your site moving."
  endif

  assign n_subheading = section.settings.subheading
  if n_subheading == blank or n_subheading contains 'Promotions, new products'
    assign n_subheading = "<p>Get Australian Stock Alerts, New Product Releases And Practical Technical Resources For Water, Wastewater And Remote-Site Applications.</p>"
  endif
-%}
<div class="newsletter has-bg-image" style="background-color: {{ section.settings.bg_color | default: '#0b0f14' }}; background:url({{ bg_img_url }}) center center no-repeat;background-size:cover;">
  <div class="{% if section.settings.fullwidth %}container-fluid{% else %}container{% endif %}" >
    <div class="section-block section-block--padding {% if section.settings.style_layout == "left" %}me-auto{% elsif section.settings.style_layout == "center" %}mx-auto{% elsif section.settings.style_layout == "right" %}ms-auto{% endif %}">
      <div class="{% if n_heading != blank or n_subheading != blank %}section-block__header {% endif %} {% if section.settings.style_layout == "left" %}text-start{% elsif section.settings.style_layout == "center" %}text-center{% elsif section.settings.style_layout == "right" %}text-end{% endif %}">
        {%- unless section.settings.sub_title == blank -%}
          <p class="sub-title">{{ section.settings.sub_title  }}</p>
        {%- endunless -%}
        {%- if n_heading != blank -%}
          <h4 class="h1--mini section-block__title">{{ n_heading }}</h4>
        {%- endif -%}
        {%- if n_subheading != blank -%}
          <div class="section-block__subtext">{{ n_subheading }}</div>
        {%- endif -%}
      </div>
      <div class="grid">
        <div class="grid__item medium-up--two-thirds medium-up--push-one-sixth">
          <div class="form-vertical">
            {% render 'newlester',
              email_placeholder: 'Work email address',
              button_label: 'Get Technical Updates',
              show_button_icon: false,
              show_email_icon: true
            %}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

  {% schema %}
  {
    "name": "Newsletter",
    "class": "index-section",
    "settings": [
    {
      "type": "checkbox",
      "id": "fullwidth",
      "label": "t:sections.collection.settings.fullwidth.label",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "transparent"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background-image"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Color text",
      "default":"#fff"
    },
    {
      "type": "color",
      "id": "color_button",
      "label": "Color button text",
      "default":"#000"
    },
    {
      "type": "color",
      "id": "bg_color_button",
      "label": "Background button",
      "default":"#fff"
    },
    {
      "type": "text",
      "id": "sub_title",
      "label": "Sub title",
      "default": "new customer discount"
    },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Subscribe to our newsletter"
      },
      {
        "type": "richtext",
        "id": "subheading",
        "label": "Subheading",
        "default": "<p>Promotions, new products and sales. Directly to your inbox.</p>"
      },
      {
        "type": "paragraph",
        "content": "Any customers who sign up will have an account created for them in Shopify. [View customers](/admin/customers?query=&accepts_marketing=1)"
      },
      {
        "type": "select",
        "id": "style_layout",
        "label": "Style layout",
        "default": "left",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ]
       }
    ],
    "presets": [
      {
        "name": "Newsletter",
        "category": "Text"
      }
    ]
  }
  {% endschema %}
  