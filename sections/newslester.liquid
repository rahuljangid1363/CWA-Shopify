<!-- newsletter.liquid -->
<style>
.newsletter{
  position: relative;
  padding: 56px 0;
  background-image: none !important;
  background-color: {{ section.settings.bg_color | default: '#0b0f14' }} !important;
  overflow: hidden;
}
.newsletter.has-bg-image::before{
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, rgba(0,0,0,.92) 0%, rgba(0,0,0,.75) 38%, rgba(0,0,0,.15) 75%, rgba(0,0,0,0) 100%);
  z-index: 1;
}
.newsletter .container,
.newsletter .container-fluid{
  position: relative;
  z-index: 2;
}
.newsletter h4,.newsletter p{
  color:{{ section.settings.color_text }};
}
.newsletter p{
  font-style: normal;
  font-weight: 400;
  font-size: 15px;
  line-height: 1.6;
  opacity: .85;
}
.newsletter .sub-title{
  margin-bottom: 12px;
  font-style: normal;
  font-weight: 400;
  font-size: 36px;
  line-height: 44px;
}

.newsletter h4{
  font-family: 'Montserrat';
  font-style: normal;
  font-weight: 800;
  font-size: 36px;
  margin-bottom: 14px;
  line-height: 1.25;
  text-transform: uppercase;
}
.newsletter .field__label{
  color: #888888;
  font-size: 1.3rem;
  top: 1.3rem;
}
.newsletter .section-block__subtext{
  margin-bottom: 22px;
  max-width: 620px;
}
.newsletter .field{
  position: relative;
}
.newsletter .field--with-icon .field__input{
  padding-left: 42px;
}
.newsletter .field--with-icon .field__label{
  left: 42px;
}
.newsletter .field__icon{
  position: absolute;
  left: 15px;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  color: #9a9a9a;
  pointer-events: none;
}
.newsletter .field__icon svg{
  width: 15px;
  height: 12px;
}
.newsletter .field__icon svg path{
  fill: currentColor;
}
.newsletter .field__input{
  margin-bottom: 0;
  height: 48px;
  border-radius: 6px;
  background-color: #fff;
  box-shadow: none;
  border: none;
}
.newsletter .footer-block__newsletter form{
  display: flex;
  max-width: 560px;
}

.newsletter .button{
  font-size: 14px;
  font-weight: 600;
  box-shadow: none;
  padding: 0 22px;
  height: 48px;
  min-height: 48px;
  min-width: unset;
  border-radius: 6px;
  background-color: {{ section.settings.bg_color_button }};
  color: {{ section.settings.color_button }};
}
.newsletter .button i{
  display: none;
}
.newsletter .button:hover{
  box-shadow: none;
  opacity: .92;
}
.newsletter .grid__item{
  max-width: 100%;
  padding: 0;
}
.newsletter .section-block{
  max-width: 560px;
}
@media (min-width:567px) {
  .newsletter .newsletter-form__field-wrapper{
    flex: 1;
    margin-right: 10px;
  }
}
@media (max-width:567px) {
  .newsletter .footer-block__newsletter form{
    flex-wrap: wrap;
    justify-content: center;
  }
  .newsletter-form__field-wrapper{
    width: 100%;
  }
 .newsletter .button{
    margin-top: 12px;
    width: 100%;
  }
}
</style>
<div class="newsletter{% if section.settings.bg_image != blank %} has-bg-image{% endif %}" {% if section.settings.bg_image != blank %} style="background-color: {{ section.settings.bg_color }}; background:url({{ section.settings.bg_image | img_url:'master' }}) center center no-repeat;background-size:cover;" {% endif %}>
  <div class="{% if section.settings.fullwidth %}container-fluid{% else %}container{% endif %}" >
    <div class="section-block section-block--padding {% if section.settings.style_layout == "left" %}me-auto{% elsif section.settings.style_layout == "center" %}mx-auto{% elsif section.settings.style_layout == "right" %}ms-auto{% endif %}">
      <div class="{% if section.settings.heading != blank or section.settings.subheading != blank %}section-block__header {% endif %} {% if section.settings.style_layout == "left" %}text-start{% elsif section.settings.style_layout == "center" %}text-center{% elsif section.settings.style_layout == "right" %}text-end{% endif %}">
        {%- unless section.settings.sub_title == blank -%}
          <p class="sub-title">{{ section.settings.sub_title  }}</p>
        {%- endunless -%}
        {%- unless section.settings.heading == blank -%}
          <h4 class="h1--mini section-block__title">{{ section.settings.heading  }}</h4>
        {%- endunless -%}
        {%- unless section.settings.subheading == blank -%}
          <div class="section-block__subtext">{{ section.settings.subheading }}</div>
        {%- endunless -%}
      </div>
      <div class="grid">
        <div class="grid__item medium-up--two-thirds medium-up--push-one-sixth">
          <div class="form-vertical">
            {% render 'newlester',
              email_placeholder: 'Work email address',
              button_label: 'Get Technical Updates',
              show_button_icon: false,
              show_email_icon: true
            %}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

  {% schema %}
  {
    "name": "Newsletter",
    "class": "index-section",
    "settings": [
    {
      "type": "checkbox",
      "id": "fullwidth",
      "label": "t:sections.collection.settings.fullwidth.label",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "transparent"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background-image"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Color text",
      "default":"#fff"
    },
    {
      "type": "color",
      "id": "color_button",
      "label": "Color button text",
      "default":"#000"
    },
    {
      "type": "color",
      "id": "bg_color_button",
      "label": "Background button",
      "default":"#fff"
    },
    {
      "type": "text",
      "id": "sub_title",
      "label": "Sub title",
      "default": "new customer discount"
    },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Subscribe to our newsletter"
      },
      {
        "type": "richtext",
        "id": "subheading",
        "label": "Subheading",
        "default": "<p>Promotions, new products and sales. Directly to your inbox.</p>"
      },
      {
        "type": "paragraph",
        "content": "Any customers who sign up will have an account created for them in Shopify. [View customers](/admin/customers?query=&accepts_marketing=1)"
      },
      {
        "type": "select",
        "id": "style_layout",
        "label": "Style layout",
        "default": "left",
        "options": [
          {
            "value": "left",
            "label": "Left"
          },
          {
            "value": "center",
            "label": "Center"
          },
          {
            "value": "right",
            "label": "Right"
          }
        ]
       }
    ],
    "presets": [
      {
        "name": "Newsletter",
        "category": "Text"
      }
    ]
  }
  {% endschema %}
  