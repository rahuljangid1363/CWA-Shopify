<!-- testimonial.liquid -->
<link rel="preload" href="{{ 'testimonial.css' | asset_url }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="{{ 'testimonial.css' | asset_url }}"></noscript>
{% render 'section-style' %}

{%- style -%}
.testimonial .slick-arrow{
  top: 50%;
  width: 58px;
  height: 58px;
  background-color: {{ section.settings.bg_button }};
  border-radius: 50%;
  border-radius: 1px solid {{ section.settings.border_button }};
}
.testimonial .slick-next:before, .testimonial .slick-prev:before{
  color:{{ section.settings.color_button }};
}
.testimonial .slick-prev:hover,.testimonial .slick-next:hover{
  background-color: {{ section.settings.bg_button_hover }} !important;
  border-radius: 1px solid {{ section.settings.border_button_hover }};
}
.testimonial .slick-prev:hover::before,.testimonial .slick-next:hover::before{
  color: {{ section.settings.color_button_hover }} !important;
}
{%- endstyle -%}


<div class="testimonial-box" {%- if section.settings.bg_image != blank -%} style="background-image:url({{ section.settings.bg_image | img_url:'master'  }});" {%- endif -%}>
  <h2 class="section-header">{{ section.settings.heading | escape }}</h2>
  <p class="section-text">{{ section.settings.text_decoration }}</p>
  <div class="testimonial">
      <div class="{%- if section.settings.fullwidth -%}container-fluid{%- else -%}container{%- endif -%}">
          <div class="testimonial-content testimonial-slick apslick ap-custom-slick"
              data-setting='{"accessibility": false, "arrows": {{ section.settings.arrows }},
              "dots": {{ section.settings.dots }}, "draggable": {{ section.settings.draggable }},
              "infinite": {{ section.settings.infinite }}, "autoplay": {{ section.settings.autoplay }},
              "autoplaySpeed": {{ section.settings.autoplaySpeed }}, "speed": {{ section.settings.speed }},
              "slidesToShow": {{ section.settings.slidesToShow }}, "slidesToScroll": {{ section.settings.slidesToScroll }},
              "vertical": false, "mobileFirst": false, "pauseOnHover": {{ section.settings.pauseOnHover }},
              "rows": {{ section.settings.rows }}, "slidesPerRow": 1, "rtl": 1,
              "slidesToShow_992": {{ section.settings.slidesToShow_992 }}, "slidesToScroll_992": {{ section.settings.slidesToScroll_992 }},
              "arrows_992": {{ section.settings.arrows_992 }}, "dots_992": {{ section.settings.dots_992 }},
              "slidesToShow_767": {{ section.settings.slidesToShow_767 }}, "slidesToScroll_767": {{ section.settings.slidesToScroll_767 }},
              "arrows_767": {{ section.settings.arrows_767 }}, "dots_767": {{ section.settings.dots_767 }},
              "slidesToShow_450": {{ section.settings.slidesToShow_450 }}, "slidesToScroll_450": {{ section.settings.slidesToScroll_450 }},
              "arrows_450": {{ section.settings.arrows_450 }}, "dots_450": {{ section.settings.dots_450 }}}'>
              {%- for block in section.blocks -%}
              <div class="testimonial-decoration" id="ap-slick-content-{{block.id}}" {{ block.shopify_attributes }}>
                  {%- style -%}
                    #ap-slick-content-{{block.id}} .title-content{
                      color:{{ block.settings.color_title_content  }}
                    }
                    #ap-slick-content-{{block.id}} .name-testimonial{
                      color:{{ block.settings.color_name  }};
                    }
                    #ap-slick-content-{{block.id}} .address-testimonial{
                      color:{{ block.settings.color_address  }};
                    }
                    #ap-slick-content-{{block.id}} .testimonial_text{
                      color:{{ block.settings.color_text_content  }};
                    }
                    #ap-slick-content-{{block.id}} .icon{
                      background-color:{{ block.settings.bg_icon }};
                    }
                    #ap-slick-content-{{block.id}} .icon svg{
                      fill:currentColor;
                      color:{{ block.settings.color_icon }}
                    }
                  {%- endstyle -%}
               
                  {%- if block.settings.title_content != blank -%}
                    <div class="testimonial-title">
                      <h3 class="title-content">
                        {{ block.settings.title_content }}
                      </h3>
                    </div>
                  {%- endif -%}
                  <p class="testimonial_text">{{ block.settings.testimonial_text }}</p>
                  <div class="d-flex testimonial-info-box ">
                    <!-- icon -->
                    {%- if block.settings.icon != blank -%}
                      <div class="icon">
                        {{ block.settings.icon }}
                      </div>
                    {%- endif -%}
                    <!-- image -->
                    <div class="testimonial-author">
                      <div class="img_testimonial">
                      {%- if block.settings.icon_testimonial != blank -%}
                        <img
                        srcset="{%- if block.settings.icon_testimonial.width >= 165 -%}{{ block.settings.icon_testimonial | img_url: '165x' }} 165w,{%- endif -%}
                          {%- if block.settings.icon_testimonial.width >= 360 -%}{{ block.settings.icon_testimonial | img_url: '360x' }} 360w,{%- endif -%}
                          {%- if block.settings.icon_testimonial.width >= 535 -%}{{ block.settings.icon_testimonial | img_url: '535x' }} 535w,{%- endif -%}
                          {%- if block.settings.icon_testimonial.width >= 750 -%}{{ block.settings.icon_testimonial | img_url: '750x' }} 750w,{%- endif -%}
                          {%- if block.settings.icon_testimonial.width >= 1070 -%}{{ block.settings.icon_testimonial | img_url: '1070x' }} 1070w,{%- endif -%}
                          {%- if block.settings.icon_testimonial.width >= 1500 -%}{{ block.settings.icon_testimonial | img_url: '1500x' }} 1500w,{%- endif -%}"
                        src="{{ block.settings.icon_testimonial | img_url: '66x' }}"
                        sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px, (min-width: 750px) calc((100vw - 130px) / 2), calc((100vw - 50px) / 2)"
                        alt="{{ block.settings.icon_testimonial.alt | escape }}"
                        loading="lazy"
                        width="{{ block.settings.icon_testimonial.width }}"
                        >
                      {%- else -%}
                        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                      {%- endif -%}
                      </div>
                    </div>
                    <!-- info -->
                    <div class="testimonial-publisher">
                      <p class="name-testimonial">{{ block.settings.name_icon }}</p>
                      <p class="address-testimonial">{{ block.settings.city_icon }}</p>
                    </div>
                  </div>
                 
                </div>
              {%- endfor -%}
          </div>
          
      </div>
  </div>
</div>



